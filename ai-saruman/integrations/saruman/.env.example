# Copy to .env.saruman. Never commit the local file or credentials.
SARUMAN_CHARACTER_NAME=Saruman
PYTHONPATH=src
PYTHONIOENCODING=utf-8
CORE_LLM_MODEL_NAME=codex/gpt-6-sol
# Reasoning is a separate setting, not a model ID suffix.
CODEX_REASONING_EFFORT=low
# Per-role providers/models: Saruman Lab -> Settings (or the game role editor).
# Shared database: data/role-models.sqlite. API providers require explicit selection.
# MiniMax M Plan Explore: Subscription Key from https://platform.minimax.io/console/plan
# Not a pay-as-you-go key. Credentials stay in this local environment file.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
LITELLM_BASE_URL=
LITELLM_API_KEY=
DSLAB_BASE_URL=https://api.dslab.tech
DSLAB_API_KEY=
VISION_LLM_MODEL_NAME=NONE
CORE_LLM_API_BASE=NONE
CORE_LLM_MAX_TOKENS=NONE
CODEX_TURN_TIMEOUT=180
# Codex uses its own login; run codex login in native Windows first.
# Optional separate account: absolute path to an isolated Codex home (see Windows guide).
# CODEX_HOME=C:/path/to/ai-saruman/integrations/saruman/data/codex-home
# Embeddings are separate from the ChatGPT subscription; disabled for first start.
EMBEDDINGS_MODEL=NONE
# Use local-only bindings; do not expose Gradio/DB/Redis/OBS publicly.
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=22228
HUD_LAYER_HOST=127.0.0.1
HUD_LAYER_PORT=22236
MINECRAFT_GATEWAY_HOST=127.0.0.1
MINECRAFT_GATEWAY_PORT=25333
MINECRAFT_GATEWAY_TIMEOUT=5
MINECRAFT_POLL_INTERVAL=0.1
# Native respawn after death, only while the agent is started (Start/Stop).
SARUMAN_AUTO_RESPAWN=true
# mods: native TreeGrow + Auto Defense; legacy: explicitly opt into old Python behavior.
SARUMAN_AUTOMATION_MODE=mods
SARUMAN_AUTONOMY_ENABLED=true
# Speech-only initiative after 3–5 quiet minutes; uses PersonaAgent's model/budget.
SARUMAN_PERSONA_INITIATIVE_ENABLED=true
# Native adapter needs JDK 21+ (javac in PATH). Optional absolute javac.exe path:
# SARUMAN_JAVAC=C:/Program Files/Java/jdk-21/bin/javac.exe
SARUMAN_SEARCH_MAX_MOVES=64
# Python callback must be reachable by the mod; same-host Windows is the first target.
MINECRAFT_CALLBACK_HOST=127.0.0.1
MINECRAFT_CALLBACK_PORT=25334
OBS_WEBSOCKET_HOST=127.0.0.1
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_PASSWORD=
VTUBE_WEBSOCKET_URL=ws://127.0.0.1:22232
TTS_ENDPOINT_URL=http://127.0.0.1:22231/
STT_BACKEND=parakeet
PARAKEET_API_URL=http://127.0.0.1:22233/v1/audio/transcriptions
PARAKEET_STREAM_URL=ws://127.0.0.1:22233/v1/audio/stream
FILTER_BASE_URL=http://127.0.0.1:22230
PARAKEET_LANGUAGE=ru
# Local Whisper setting; does not select the Parakeet container provider.
STT_COMPUTE_DEVICE=cpu
SOUND_DEVICE_IN=CABLE Input (VB-Audio Virtual Cable)
SOUND_DEVICE_OUT=CABLE Output (VB-Audio Virtual Cable)
FX_SOUND_DEVICE_IN=CABLE Input (VB-Audio Virtual Cable)
FX_SOUND_DEVICE_OUT=CABLE Output (VB-Audio Virtual Cable)
SOUND_DEVICE_SR=48000
REDIS_URL=redis://127.0.0.1:6379/0
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=saruman
POSTGRES_USER=saruman
# Required: replace with a unique password before starting Compose.
POSTGRES_PASSWORD=
DONATIONALERTS_TOKEN=

# Optional social integrations; leave empty until configured.
TWITCH_APP_ID=
TWITCH_APP_SECRET=
TWITCH_TARGET_CHANNEL=
SELF_TWITCH_USERNAME=
YOUTUBE_STREAM_API_KEY=
YOUTUBE_CHANNEL_ID=
