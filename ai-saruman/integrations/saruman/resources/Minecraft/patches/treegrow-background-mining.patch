+    /** The flow in which the tree does not grow on the first place of the task. */
+    private void runSiteSwitch(ClientGameTestContext context, TestSingleplayerContext game, CheckpointLog checks,
+                               long visibleStart, CycleSpec spec, ClientScenarios.Scenario scenario) {
+        context.runOnClient(client -> executeClientCommand("treegrow start"));
+        context.waitTicks(3);
+        GrowTreeTask task = context.computeOnClient(client -> TreeGrowClient.current());
+        if (task == null) {
+            // A task that never started is a fact of the run, not a null pointer inside the client
+            // thread: the named check of the flow carries the reason.
+            checkpoint(checks, ClientScenarios.Role.SCHEDULER_TICKED, () ->
+                    require(false, "the command /treegrow start must create a task before it can change "
+                            + "the place"));
+            return;
+        }
+        Set<String> stages = new LinkedHashSet<>();
+        List<BlockPos> sites = new ArrayList<>();
+        int[] usesOnFirstSite = {0};
+        int[] totalUses = {0};
+        boolean[] blockedBeforePlant = {true};
+        long deadline = System.nanoTime() + 45_000_000_000L;
+        while (System.nanoTime() < deadline) {
+            context.waitTick();
+            String stage = context.computeOnClient(client -> task.stage());
+            if (stage != null && !stage.isBlank()) stages.add(stage);
+            BlockPos site = context.computeOnClient(client -> task.site());
+            if (site != null && (sites.isEmpty() || !sites.get(sites.size() - 1).equals(site))) {
+                sites.add(site);
+                // The tree feature of the game cannot grow into a closed volume: the base of the
+                // trunk moves below the ground, the feature fails and the sapling stays. The task
+                // spends its bone meal on this place and looks for another one.
+                boolean planted = game.getServer().computeOnServer(server ->
+                        server.getOverworld().getBlockState(site).isOf(Blocks.OAK_SAPLING));
+                if (planted) blockedBeforePlant[0] = false;
+                game.getServer().runCommand("setblock " + site.getX() + " " + (site.getY() + 1)
+                        + " " + site.getZ() + " stone");
+                System.out.println("LAB_SITE_BLOCKED:" + site + " plantedBefore=" + planted);
+            }
+            int uses = context.computeOnClient(client -> task.uses());
+            if (sites.size() == 1) usesOnFirstSite[0] = Math.max(usesOnFirstSite[0], uses);
+            totalUses[0] = context.computeOnClient(client -> task.boneUses());
+            if (sites.size() >= 2) break;
+            if (context.computeOnClient(client -> task.isFinished())) break;
+        }
+        final int firstUses = usesOnFirstSite[0];
+        final int uses = totalUses[0];
+        final boolean blockedBefore = blockedBeforePlant[0];
+        // The state of the task is published on the client tick, so the fixture waits a few ticks
+        // after the change of the place: the external reader then sees the new counters.
+        context.waitTicks(10);
+        checkpoint(checks, ClientScenarios.Role.SITE_SWITCHED, () -> {
+            require(sites.size() >= 2,
+                    "the task must leave the first place and use another one, places: " + sites);
+            require(!sites.get(0).equals(sites.get(1)),
+                    "the second place must differ from the first: " + sites);
+            require(blockedBefore,
+                    "the fixture must close the volume above the first place before the sapling is planted");
+        });
+        checkpoint(checks, ClientScenarios.Role.SITES_LIMIT, () -> {
+            require(sites.size() <= 3, "not more than three places may be used in one run: " + sites);
+            int used = context.computeOnClient(client -> task.sites());
+            require(used >= 2 && used <= 3, "the task must count the places it used: " + used);
+        });
+        checkpoint(checks, ClientScenarios.Role.USES_PER_SITE, () -> {
+            require(firstUses == 16,
+                    "the task must spend 16 bone meal applications on the first place: " + firstUses);
+            require(uses <= 16 * Math.max(1, sites.size()),
+                    "not more than 16 bone meal applications per place: " + uses
+                            + " in " + sites.size() + " places");
+        });
+        checkpoint(checks, ClientScenarios.Role.NO_TREE_GROWN, () -> {
+            require(!task.success(), "the task must not report a grown tree where no tree grew");
+            BlockPos first = sites.isEmpty() ? null : sites.get(0);
+            if (first != null) {
+                boolean tree = game.getServer().computeOnServer(server -> {
+                    var world = server.getOverworld();
+                    for (int dy = 0; dy <= 8; dy++) {
+                        var state = world.getBlockState(first.up(dy));
+                        if (state.isOf(Blocks.OAK_LOG) || state.isOf(Blocks.OAK_LEAVES)) return true;
+                    }
+                    return false;
+                });
+                require(!tree, "no tree may stand on the first place: " + first);
+            }
+        });
+        checkpoint(checks, ClientScenarios.Role.GIVE_SENT, () -> {
+            int sends = context.computeOnClient(client -> task.giveSends());
+            require(sends == 0, "the bone meal command must not be sent, the stock of the fixture is sufficient");
+        });
+        checkpoint(checks, ClientScenarios.Role.STATE_COUNTERS, () -> {
+            String state = externalState(context);
+            require(state.contains("sites="), "the external state must show the number of places: " + state);
+            require(state.contains("uses="), "the external state must show the bone meal applications: " + state);
+            require(numberAfter(state, "sites=") >= 2,
+                    "the external state must show the change of the place: " + state);
+        });
+        checkpoint(checks, ClientScenarios.Role.SCHEDULER_TICKED, () ->
+                require(stages.size() >= 3,
+                        "the scheduler must tick the task through its stages, seen: " + stages));
+        checkpoint(checks, ClientScenarios.Role.DURATION_LIMIT, () -> {
+            require(GrowTreeTask.LIMIT_NANOS == 300_000_000_000L,
+                    "the task limit must be five minutes, got " + GrowTreeTask.LIMIT_NANOS);
+            String expiry = context.computeOnClient(client -> task.expiryReason());
+            require("Неудача: истекло 5 минут".equals(expiry),
+                    "the exhaustion of the limit must end the task with a clear reason, got " + expiry);
+        });
