+    private static void executeClientCommand(String command) {
+        var client = net.minecraft.client.MinecraftClient.getInstance();
+        var dispatcher = net.fabricmc.fabric.api.client.command.v2.ClientCommandManager.getActiveDispatcher();
+        require(dispatcher != null, "registered Fabric client dispatcher exists");
+        try {
+            require(dispatcher.execute(command, (net.fabricmc.fabric.api.client.command.v2.FabricClientCommandSource)
+                    client.getNetworkHandler().getCommandSource()) == 1, "client command accepted: " + command);
+        } catch (com.mojang.brigadier.exceptions.CommandSyntaxException exception) {
+            throw new AssertionError("registered client command failed: " + command, exception);
+        }
+    }
