-                            + interruption);
-            require(released, "the scheduler must be free after the exhausted search");
-        });
-        Map<String, String> after = blockSnapshot(game);
-        GrownTreeRegion region = new GrownTreeRegion(
-                List.of(blockId(spec.log()), blockId(spec.leaf())),
-                List.of(blockId(Blocks.OAK_LOG), blockId(Blocks.OAK_LEAVES)),
-                blockId(spec.log()));
-        GrownTreeRegion.Verdict verdict = region.check(worldBefore, after, null, null, List.of(),
