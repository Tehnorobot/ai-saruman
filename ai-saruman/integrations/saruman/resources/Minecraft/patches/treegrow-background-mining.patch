+        boolean running = !task.isFinished();
+        Set<String> stages = new LinkedHashSet<>();
+        boolean[] owned = {false};
+        // The world holds no supported sapling and no leaves, so the acquisition of UnionClef cannot
+        // deliver one. The environment may end the acquisition on its own. When it does not within
+        // the window of the scenario, the fixture stops the child of UnionClef: that is the
+        // observable end of the acquisition, and the reaction of the task is observed in both cases.
+        boolean ended = false;
+        boolean stoppedByFixture = false;
+        long deadline = System.nanoTime() + 20_000_000_000L;
+        while (System.nanoTime() < deadline) {
+            context.waitTick();
+            String stage = context.computeOnClient(client -> task.stage());
+            if (stage != null && !stage.isBlank()) stages.add(stage);
+            owned[0] |= context.computeOnClient(
+                    client -> AltoClef.getInstance().getUserTaskChain().getCurrentTask() == task);
+            if (context.computeOnClient(client -> task.isFinished())) { ended = true; break; }
+        }
+        if (!ended) {
+            stoppedByFixture = stopAcquisitionChild(context);
+            deadline = System.nanoTime() + 10_000_000_000L;
+            while (stoppedByFixture && System.nanoTime() < deadline) {
+                context.waitTick();
+                if (context.computeOnClient(client -> task.isFinished())) { ended = true; break; }
+            }
+        }
+        System.out.println("LAB_SAPLING_ACQUISITION_ENDED:"
+                + (stoppedByFixture ? "FIXTURE_STOPPED_THE_CHILD" : "ENVIRONMENT_ENDED_IT"));
+        String reason = context.computeOnClient(client -> task.reason());
+        int[] actions = context.computeOnClient(client -> new int[]{task.plantSends(), task.boneUses()});
+        boolean plantedInWorld = game.getServer().computeOnServer(server -> {
+            var world = server.getOverworld();
+            for (BlockPos p : BlockPos.iterate(-16, -60, -16, 16, -60, 16)) {
+                var state = world.getBlockState(p);
+                if (state.isOf(Blocks.OAK_SAPLING) || state.isOf(Blocks.BIRCH_SAPLING)) return true;
+            }
+            return false;
