+    /** The flow in which the player leaves the world while the task runs. */
+    private void runWorldExit(ClientGameTestContext context, TestSingleplayerContext game, CheckpointLog checks,
+                              long visibleStart, CycleSpec spec, ClientScenarios.Scenario scenario) {
+        context.runOnClient(client -> executeClientCommand("treegrow start"));
+        context.waitTicks(3);
+        GrowTreeTask task = context.computeOnClient(client -> TreeGrowClient.current());
+        if (task == null) {
+            // A task that never started is a fact of the run, not a null pointer inside the client
+            // thread: the named check of the flow carries the reason.
+            checkpoint(checks, ClientScenarios.Role.SCHEDULER_TICKED, () ->
+                    require(false, "the command /treegrow start must create a task before the player "
+                            + "leaves the world"));
+            return;
+        }
+        boolean running = !task.isFinished();
+        boolean owned = context.computeOnClient(client ->
+                AltoClef.getInstance().getUserTaskChain().getCurrentTask() == task);
+        int[] actionsBefore = context.computeOnClient(client -> new int[]{task.plantSends(), task.boneUses()});
+        // The player leaves the world: the client closes the connection to the integrated server.
+        context.runOnClient(client -> {
+            var handler = client.getNetworkHandler();
+            require(handler != null, "the client must have a network handler before the world exit");
+            handler.getConnection().disconnect(net.minecraft.text.Text.literal("LAB world exit"));
+        });
+        boolean cancelled = false;
+        long deadline = System.nanoTime() + 10_000_000_000L;
+        while (System.nanoTime() < deadline) {
+            context.waitTick();
+            if (context.computeOnClient(client -> task.isFinished())) { cancelled = true; break; }
+        }
+        String reason = context.computeOnClient(client -> task.reason());
+        System.out.println("LAB_WORLD_EXIT_REASON:" + reason);
+        final boolean cancelledRun = cancelled;
+        checkpoint(checks, ClientScenarios.Role.WORLD_EXIT_CANCEL, () -> {
+            require(running, "the task must run before the player leaves the world");
+            require(cancelledRun, "leaving the world must cancel the task");
+            require(!task.success(), "a task cancelled by the world exit must not report a grown tree");
+            require(reason != null && reason.contains("Отменено"),
+                    "the world exit must cancel the task with a clear reason: " + reason);
+            require(reason.contains("мира") || reason.contains("выход"),
+                    "the reason must name the world exit: " + reason);
+        });
+        checkpoint(checks, ClientScenarios.Role.SCHEDULER_TICKED, () ->
+                require(owned, "the production task must be the current task of the UnionClef chain"));
+        checkpoint(checks, ClientScenarios.Role.NO_RESUME, () -> {
+            require(context.computeOnClient(client -> task.isFinished()),
+                    "the cancelled task must stay finished after the world exit");
+            require(context.computeOnClient(client -> TreeGrowClient.current() == task),
+                    "the addon must not start a new task on its own after the world exit");
+            boolean free = true;
+            try {
+                context.waitFor(client -> !AltoClef.getInstance().getUserTaskChain().isActive(), 40);
+            } catch (Throwable timeout) {
+                free = false;
+            }
+            require(free, "the scheduler must be free after the world exit");
+        });
+        checkpoint(checks, ClientScenarios.Role.NO_ACTIONS_AFTER_CANCEL, () -> {
+            int[] actions = context.computeOnClient(client -> new int[]{task.plantSends(), task.boneUses()});
+            require(actions[0] == actionsBefore[0] && actions[1] == actionsBefore[1],
+                    "a task cancelled by the world exit must not plant a sapling or use bone meal again");
+        });
+        checkpoint(checks, ClientScenarios.Role.EXTERNAL_STATE, () -> {
+            String state = externalState(context);
+            require(state.contains("outcome=cancelled"),
+                    "the external reader must see the cancelled result: " + state);
+            require(state.contains("reason=") && !state.contains("reason=;"),
+                    "the external reader must see the reason of the cancellation: " + state);
+        });
+        // The client game test framework requires the client to finish on the title screen. This
