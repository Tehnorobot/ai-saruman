-     * <p>The free volume is read from the snapshot that was taken before the task acted. The task
-     * plants its sapling in the root itself, so the state after the run would report that planted
-     * sapling as a blocked cell of the free volume.
-     */
-    private static String siteProblem(Map<String, String> before, BlockPos root, TestSingleplayerContext game) {
-        String soil = before.get(position(root.down()));
-        if (soil == null || !SoilBlocks.isSoilId(soil)) {
-            return "the ground under the root is not a soil block: " + soil;
-        }
-        for (int dy = 0; dy < 9; dy++) {
-            for (int dx = -2; dx <= 2; dx++) {
-                for (int dz = -2; dz <= 2; dz++) {
-                    BlockPos cell = root.add(dx, dy, dz);
-                    if (before.containsKey(position(cell))) {
-                        return "the free space above the root is blocked at " + cell;
-                    }
-                }
-            }
-        }
-        boolean companion = false;
-        for (Direction direction : Direction.Type.HORIZONTAL) {
-            BlockPos cell = root.offset(direction, 2);
-            if (before.containsKey(position(cell)) || before.containsKey(position(cell.up()))) continue;
-            if (!solidSupport(game, cell.down())) continue;
-            companion = true;
-            break;
