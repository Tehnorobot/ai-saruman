+    private static void waitWall(ClientGameTestContext context, long duration) {
+        long until = System.nanoTime() + duration;
+        while (System.nanoTime() < until) context.waitTick();
+    }
+
+    /**
+     * How many different stages the scheduler must have ticked in the given flow.
+     *
+     * <p>The full cycle reports the stages of the search, the approach, the planting and the
+     * growth; the refused give reports the stage of waiting for the bone meal.
+     */
+    private static int requiredStages(ClientScenarios.Scenario scenario) {
+        return switch (scenario.flow()) {
+            case CYCLE -> 2;
+            case BONE_MEAL_GIVE -> 2;
+            case BONE_MEAL_NO_PERMISSION -> 1;
+            case DEATH_CANCEL, ENTRYPOINTS -> 0;
+            case SAPLING_UNAVAILABLE -> 1;
+            case SITE_SWITCH -> 3;
+            case WORLD_EXIT -> 0;
+            case UNSUITABLE_GROUND -> 1;
+        };
+    }
+
+    @FunctionalInterface
+    private interface Body {
+        void run() throws Throwable;
+    }
+
+    /** Evaluates one checkpoint and records its own named result. */
+    private static void checkpoint(CheckpointLog checks, ClientScenarios.Role role, Body body) {
+        try {
+            body.run();
+            checks.pass(role);
+        } catch (Throwable failure) {
+            checks.fail(role, failure);
+            throw propagate(failure);
+        }
+    }
+
+    private static void require(boolean value, String message) {
+        if (!value) throw new AssertionError(message);
+    }
+
+    private static RuntimeException propagate(Throwable failure) {
+        if (failure instanceof RuntimeException runtime) return runtime;
+        if (failure instanceof Error error) throw error;
+        return new IllegalStateException(failure);
+    }
+
+    /** Stage texts the production task reports in chat. */
