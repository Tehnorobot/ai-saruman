+    /** The flow in which the player dies while the task runs. */
+    private void runDeathCancel(ClientGameTestContext context, TestSingleplayerContext game, CheckpointLog checks,
+                                long visibleStart, CycleSpec spec, ClientScenarios.Scenario scenario) {
+        context.runOnClient(client -> executeClientCommand("treegrow start"));
+        context.waitTicks(3);
+        GrowTreeTask task = context.computeOnClient(client -> TreeGrowClient.current());
+        boolean running = task != null && !task.isFinished();
+        // The scheduler of UnionClef must have taken the task, and the addon must release it again
+        // when the death ends the run, whoever noticed the death first.
+        boolean runnerActive = context.computeOnClient(
+                client -> AltoClef.getInstance().getTaskRunner().isActive());
+        boolean owned = context.computeOnClient(client ->
+                AltoClef.getInstance().getUserTaskChain().getCurrentTask() == task);
+        game.getServer().runCommand("kill @a");
+        boolean cancelled = false;
+        int[] actionsAtCancel = new int[2];
+        try {
+            context.waitFor(client -> task != null && task.isFinished(), 80);
+            cancelled = true;
+        } catch (Throwable timeout) {
+            cancelled = false;
+        }
+        if (cancelled) {
+            actionsAtCancel = context.computeOnClient(client -> new int[]{task.plantSends(), task.boneUses()});
+        }
+        final boolean cancelledByDeath = cancelled;
+        final int[] actionsAtDeath = actionsAtCancel;
+        checkpoint(checks, ClientScenarios.Role.DEATH_CANCEL, () -> {
+            require(running, "the task must run before the player dies");
+            require(cancelledByDeath, "the death of the player must cancel the task");
+            require(!task.success(), "a task cancelled by the death must not report a grown tree");
+            String reason = context.computeOnClient(client -> task.reason());
+            require(reason.contains("Отменено"),
+                    "the death must cancel the task with a clear reason: " + reason);
+        });
+        checkpoint(checks, ClientScenarios.Role.SCHEDULER_TICKED, () -> {
+            require(runnerActive, "the chat start must activate the UnionClef task runner");
+            require(owned, "the production task must be the current task of the UnionClef chain");
+        });
+        // The player returns to the world; the cancelled task must not continue on its own.
+        context.runOnClient(client -> {
+            if (client.player != null && !client.player.isAlive()) client.player.requestRespawn();
+        });
+        context.waitTicks(10);
