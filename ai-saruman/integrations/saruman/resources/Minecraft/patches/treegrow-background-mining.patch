-            require(owned, "the external command must hand the identical task to the installed UnionClef");
-        });
-        // The external cancel goes through the same installed API, not through the chat command.
-        Py4jCommandConnection.execute(address, prefix + "treegrow stop");
-        context.waitFor(client -> external.isFinished(), 80);
-        checkpoint(checks, ClientScenarios.Role.EXTERNAL_STOP, () -> {
