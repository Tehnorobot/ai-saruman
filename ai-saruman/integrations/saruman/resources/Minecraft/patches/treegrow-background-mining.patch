-    /**
-     * Grants the right for {@code /give} to the test player, or takes it back.
-     *
-     * <p>The operator list of the server is the only mechanism that works in the integrated
-     * server of the client game test. The commands {@code op} and {@code deop} are registered
-     * for dedicated servers only, so the server answered "Unknown or incomplete command" for
-     * them, the test player stayed a player without any right and the scenario without the right
-     * passed without ever having had one. The same mechanism is used for both directions now,
-     * so the scenario without the right really loses a right that it had before.
-     *
-     * <p>The level of the operator is the level two of a game master, the level the command
-     * {@code /give} needs. The addon itself never changes the rights of the player.
-     *
-     * <p>The player of the client game test has to be connected to the integrated server before
-     * its rights can be changed, so the fixture waits for it with a bounded wait. The state of
-     * the operator list is read back from the server right after the change, so a grant that did
-     * not reach the server fails here with a clear message instead of failing later in the run.
-     */
-    private static void setGiveRights(ClientGameTestContext context, TestSingleplayerContext game,
-                                      boolean permitted) {
-        long deadline = System.nanoTime() + 10_000_000_000L;
-        while (game.getServer().computeOnServer(server -> server.getPlayerManager().getPlayerList().isEmpty())) {
-            require(System.nanoTime() < deadline,
-                    "the test player must be connected to the server before its rights are changed");
-            context.waitTick();
-        }
-        boolean operator = game.getServer().computeOnServer(server -> {
-            var manager = server.getPlayerManager();
-            // The test world has exactly one player: the client of the game test.
-            var entry = manager.getPlayerList().stream()
-                    .map(net.minecraft.server.network.ServerPlayerEntity::getPlayerConfigEntry)
-                    .findFirst()
-                    .orElseThrow(() -> new AssertionError("the test player must be connected to the server"));
-            manager.addToOperators(entry, Optional.of(LeveledPermissionPredicate.GAMEMASTERS),
-                    Optional.of(false));
-            if (!permitted) manager.removeFromOperators(entry);
-            return manager.isOperator(entry);
-        });
-        require(operator == permitted,
-                "the operator list of the server must show the requested right of the player, wanted "
-                        + permitted + ", operator: " + operator);
-    }
