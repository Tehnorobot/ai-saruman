+    /** Places a small oak with leaves inside the 64 block radius of the launch point. */
+    private static BlockPos placeFixtureTree(TestSingleplayerContext game) {
+        int ground = game.getServer().computeOnServer(server ->
+                server.getOverworld().getTopY(Heightmap.Type.WORLD_SURFACE, 24, 0));
+        int base = Math.max(ground, -59);
+        game.getServer().runCommand("setblock 24 " + base + " 0 oak_log");
+        game.getServer().runCommand("setblock 24 " + (base + 1) + " 0 oak_log");
+        game.getServer().runCommand("setblock 24 " + (base + 2) + " 0 oak_log");
+        for (int dx = -1; dx <= 1; dx++) {
+            for (int dz = -1; dz <= 1; dz++) {
+                for (int dy = 3; dy <= 4; dy++) {
+                    if (dy == 4 && Math.abs(dx) == 1 && Math.abs(dz) == 1) continue;
+                    game.getServer().runCommand("setblock " + (24 + dx) + " " + (base + dy) + " " + dz + " oak_leaves");
+                }
+            }
+        }
+        return new BlockPos(24, base, 0);
+    }
