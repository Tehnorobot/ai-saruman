+            require(actions[0] == 0, "no sapling may be planted when none is available: " + actions[0]);
+            require(actions[1] == 0, "no bone meal may be spent when no sapling is available: " + actions[1]);
+            require(!plantedInWorld, "no sapling may stand in the world after the run");
+        });
+        checkpoint(checks, ClientScenarios.Role.FAILURE_REASON, () -> {
+            require(reason != null && !reason.isBlank(), "the failed run must name a reason: " + reason);
+            require(reason.contains("саженец"), "the reason must name the missing sapling: " + reason);
+            require(SaplingAvailability.NO_SAPLING_REASON.equals(reason)
+                            || SaplingAvailability.ACQUISITION_TIMEOUT_REASON.equals(reason),
+                    "the reason must be one of the two reasons of the shared rule: " + reason);
+        });
+        checkpoint(checks, ClientScenarios.Role.SCHEDULER_TICKED, () -> {
+            require(owned[0], "the production task must be the current task of the UnionClef chain");
+            require(stages.contains("Получение саженца через UnionClef"),
+                    "the task must ask UnionClef for a sapling, stages: " + stages);
