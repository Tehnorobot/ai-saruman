+    /**
+     * The flow in which no place of the reachable area has suitable ground.
+     *
+     * <p>The task searches the whole radius of 64 blocks for a place with suitable ground. The
+     * search reads the ground below a candidate first and the whole volume of the crown of a tree
+     * only when the ground is suitable, so the exhaustion of the radius needs a bounded number of
+     * ticks: the radius offers 115404 candidates and the task reads at most
+     * {@link SiteSearch#WORK_PER_TICK} of them in one tick, so the search ends after 57 ticks.
+     * That is far below the 200 ticks after which the installed UnionClef takes the scheduler away
+     * from a user task whose player stands still, so the task ends with its own reason instead of
+     * an interruption from the outside. The scenario therefore observes the terminal result of the
+     * exhausted search: it chose no place, it planted nothing, it spent no bone meal and it named
+     * the exhausted radius.
+     */
+    private void runUnsuitableGround(ClientGameTestContext context, TestSingleplayerContext game, CheckpointLog checks,
+                                     long visibleStart, CycleSpec spec, ClientScenarios.Scenario scenario) {
+        Map<String, String> worldBefore = blockSnapshot(game);
+        context.runOnClient(client -> executeClientCommand("treegrow start"));
+        context.waitTicks(3);
+        GrowTreeTask task = context.computeOnClient(client -> TreeGrowClient.current());
+        if (task == null) {
+            // A task that never started is a fact of the run, not a null pointer inside the client
+            // thread: the named check of the flow carries the reason.
+            checkpoint(checks, ClientScenarios.Role.SCHEDULER_TICKED, () ->
+                    require(false, "the command /treegrow start must create a task before it can "
+                            + "search for a place"));
+            return;
+        }
+        Set<String> stages = new LinkedHashSet<>();
+        int waitedTicks = 0;
+        // The window of the observation is longer than the time the search needs (57 ticks, about
+        // three seconds of game time), so a slow client still sees the end of the radius. The
+        // window stays well inside the wall clock guard of the harness (52 seconds).
+        long deadline = System.nanoTime() + 30_000_000_000L;
+        while (System.nanoTime() < deadline) {
+            context.waitTick();
+            waitedTicks++;
+            String stage = context.computeOnClient(client -> task.stage());
+            if (stage != null && !stage.isBlank()) stages.add(stage);
+            if (context.computeOnClient(client -> task.isFinished())) break;
+        }
+        final int usedSites = context.computeOnClient(client -> task.sites());
+        final int plants = context.computeOnClient(client -> task.plantSends());
+        final int uses = context.computeOnClient(client -> task.boneUses());
+        final String stage = context.computeOnClient(client -> task.stage());
+        final String reason = context.computeOnClient(client -> task.reason());
+        final boolean finished = context.computeOnClient(client -> task.isFinished());
+        final String interruption = context.computeOnClient(client -> task.interruption());
+        final BlockPos site = context.computeOnClient(client -> task.site());
+        // The measured cost of the search: the number of candidates of the radius of 64 blocks,
+        // the budget of one tick and the number of ticks the exhaustion of the radius needs.
+        long candidates = TreeGeometry.Search.candidateCount();
+        System.out.println("LAB_SEARCH_CANDIDATES:" + candidates);
+        System.out.println("LAB_SEARCH_WORK_PER_TICK:" + SiteSearch.WORK_PER_TICK);
+        System.out.println("LAB_SEARCH_TICKS_TO_EXHAUST:" + SiteSearch.ticksToExhaust(candidates));
+        System.out.println("LAB_SEARCH_WAITED_TICKS:" + waitedTicks);
+        System.out.println("LAB_TASK_INTERRUPTION:" + interruption);
+        // The scheduler has to be free again after the terminal result of the task.
+        boolean schedulerReleased = false;
+        for (int attempt = 0; attempt < 40 && !schedulerReleased; attempt++) {
+            context.waitTick();
+            schedulerReleased = context.computeOnClient(
+                    client -> !AltoClef.getInstance().getUserTaskChain().isActive());
+        }
+        final boolean released = schedulerReleased;
+        checkpoint(checks, ClientScenarios.Role.NO_SITE_CHOSEN, () -> {
+            require(site == null, "the task must not choose a place without suitable ground: " + site);
+            require(usedSites == 0, "the task must not use a place without suitable ground: " + usedSites);
+            require(plants == 0, "the task must not plant a sapling without suitable ground: " + plants);
+            require(uses == 0, "the task must not spend bone meal without suitable ground: " + uses);
+            require(finished, "the exhausted search must end the task, the stage is still: " + stage);
+            require("Неудача: нет подходящего места в радиусе 64 блоков".equals(reason),
+                    "the exhausted search must end the task with a clear reason: " + reason);
+            require(interruption.isEmpty(),
+                    "the search must reach the end of the radius on its own, not by an interruption: "
+                            + interruption);
+            require(released, "the scheduler must be free after the exhausted search");
+        });
+        Map<String, String> after = blockSnapshot(game);
+        GrownTreeRegion region = new GrownTreeRegion(
+                List.of(blockId(spec.log()), blockId(spec.leaf())),
+                List.of(blockId(Blocks.OAK_LOG), blockId(Blocks.OAK_LEAVES)),
+                blockId(spec.log()));
+        GrownTreeRegion.Verdict verdict = region.check(worldBefore, after, null, null, List.of(),
+                blockId(spec.saplingBlock()));
+        for (String line : verdict.report()) {
+            System.out.println(line);
+        }
+        checkpoint(checks, ClientScenarios.Role.NO_WORLD_CHANGES, () ->
+                require(verdict.unexpected().isEmpty(),
+                        "the addon must not change the world while it looks for a place: "
+                                + verdict.unexpectedKeys()));
+        checkpoint(checks, ClientScenarios.Role.CHAT_STAGES, () -> {
+            List<String> chat = context.computeOnClient(client -> chatMessages(client));
+            require(chat.stream().anyMatch(line -> STAGES.contains(stripPrefix(line))),
+                    "the chat must show the current stage of the task: " + chat);
+        });
+        checkpoint(checks, ClientScenarios.Role.DURATION_LIMIT, () -> {
+            require(GrowTreeTask.LIMIT_NANOS == 300_000_000_000L,
+                    "the task limit must be five minutes, got " + GrowTreeTask.LIMIT_NANOS);
+            long remaining = context.computeOnClient(client -> task.remainingNanos());
+            require(remaining > 0 && remaining <= GrowTreeTask.LIMIT_NANOS,
+                    "the task must count its duration from the moment of the start");
+            String expiry = context.computeOnClient(client -> task.expiryReason());
+            require("Неудача: истекло 5 минут".equals(expiry),
+                    "the exhaustion of the limit must end the task with a clear reason, got " + expiry);
+        });
+        checkpoint(checks, ClientScenarios.Role.STATE_COUNTERS, () -> {
+            String state = externalState(context);
+            require(numberAfter(state, "sites=") == 0,
+                    "the external state must show that no place was used: " + state);
+            require(numberAfter(state, "uses=") == 0,
+                    "the external state must show that no bone meal was spent: " + state);
+        });
+        checkpoint(checks, ClientScenarios.Role.SCHEDULER_TICKED, () ->
+                require(stages.size() >= requiredStages(scenario),
+                        "the scheduler must tick the task through its stages, seen: " + stages));
+    }
