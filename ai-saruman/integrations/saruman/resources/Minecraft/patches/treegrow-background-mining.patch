+    /**
+     * The occupied cells of the free volume of the site after the run.
+     *
+     * <p>Only the planted tree may occupy the volume of the site: any other block would mean that
+     * the task changed the world around the site.
+     */
+    private static String volumeProblem(TestSingleplayerContext game, BlockPos root, Block log, Block leaf,
+                                        Block sapling) {
+        String[] problem = new String[1];
+        List<String> occupied = new ArrayList<>();
+        game.getServer().runOnServer(server -> {
+            var world = server.getOverworld();
+            for (int dy = 0; dy < 9; dy++) {
+                for (int dx = -2; dx <= 2; dx++) {
+                    for (int dz = -2; dz <= 2; dz++) {
+                        BlockPos cell = root.add(dx, dy, dz);
+                        var state = world.getBlockState(cell);
+                        if (state.isAir()) continue;
+                        occupied.add(cell + "=" + Registries.BLOCK.getId(state.getBlock()).toString());
+                        if (!state.isOf(log) && !state.isOf(leaf) && !state.isOf(sapling)) {
+                            problem[0] = "the free volume of the site holds a block that is not part of the tree: "
+                                    + cell;
+                        }
+                    }
+                }
+            }
+        });
+        System.out.println("LAB_SITE_OCCUPIED_AFTER:" + root + " " + occupied);
