-        long candidates = TreeGeometry.Search.candidateCount();
-        System.out.println("LAB_SEARCH_CANDIDATES:" + candidates);
-        System.out.println("LAB_SEARCH_WORK_PER_TICK:" + SiteSearch.WORK_PER_TICK);
-        System.out.println("LAB_SEARCH_TICKS_TO_EXHAUST:" + SiteSearch.ticksToExhaust(candidates));
-        System.out.println("LAB_SEARCH_WAITED_TICKS:" + waitedTicks);
-        System.out.println("LAB_TASK_INTERRUPTION:" + interruption);
-        // The scheduler has to be free again after the terminal result of the task.
-        boolean schedulerReleased = false;
-        for (int attempt = 0; attempt < 40 && !schedulerReleased; attempt++) {
-            context.waitTick();
-            schedulerReleased = context.computeOnClient(
-                    client -> !AltoClef.getInstance().getUserTaskChain().isActive());
