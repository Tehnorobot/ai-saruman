+plugins {
+    id 'net.fabricmc.fabric-loom-remap' version '1.15.5'
+}
+
+group = 'lab.treegrow'
+version = '0.1.0'
+base { archivesName = 'treegrow' }
+
+repositories { mavenCentral() }
+
+dependencies {
+    minecraft 'com.mojang:minecraft:1.21.11'
+    mappings 'net.fabricmc:yarn:1.21.11+build.3:v2'
+    modImplementation 'net.fabricmc:fabric-loader:0.19.2'
+    modImplementation 'net.fabricmc.fabric-api:fabric-api:0.141.3+1.21.11'
+    modImplementation files('libs/unionclef-1.21.11-0.95.61.jar')
+    // InputControls' public signature uses the already pinned nested Tungsten enum.
+    modCompileOnly files('libs/unionclef-nested/tungsten-BETA-1.0.0.jar')
+    compileOnly files('libs/unionclef-nested/mixinextras-fabric-0.3.5.jar')
+    // Loom strips nested-mod declarations from remapped local mods. Keep the original
+    // release's nested runtime dependencies explicitly, with byte-identical vendored copies.
+    modLocalRuntime files('libs/unionclef-nested/tungsten-BETA-1.0.0.jar',
+            'libs/unionclef-nested/nether-pathfinder-1.5.jar',
+            'libs/unionclef-nested/mixinextras-fabric-0.3.5.jar')
+    testImplementation 'org.junit.jupiter:junit-jupiter:5.11.4'
+    testRuntimeOnly 'org.junit.platform:junit-platform-launcher:1.11.4'
+}
+
+java {
+    toolchain.languageVersion = JavaLanguageVersion.of(21)
+    withSourcesJar()
+}
+tasks.withType(JavaCompile).configureEach { options.release = 21 }
+tasks.withType(Test).configureEach {
+    useJUnitPlatform()
+    maxHeapSize = '1G'
+    jvmArgs '-XX:ActiveProcessorCount=4'
+    testLogging { events 'passed', 'failed', 'skipped' }
+}
+tasks.named('processResources') {
+    inputs.property 'version', project.version
+    filesMatching('fabric.mod.json') { expand version: project.version }
+}
+
+tasks.register('verifyUnionClef') {
+    def jar = layout.projectDirectory.file('libs/unionclef-1.21.11-0.95.61.jar')
+    inputs.file jar
+    doLast {
+        def actual = java.security.MessageDigest.getInstance('SHA-256').digest(jar.asFile.bytes).encodeHex().toString()
+        if (actual != '76bbb677d2f8294e6d2de98b554f81818ae15605ef8a82ff7e1d3b9b82555d1b') {
+            throw new GradleException('Unexpected UnionClef artifact SHA-256: ' + actual)
+        }
+        def nested = [
+            'tungsten-BETA-1.0.0.jar': '17908bc628064919a7b205ca241380293833408ce43a2fe0b19fa3b43dbae883',
+            'nether-pathfinder-1.5.jar': '23c7b57cd537647f624d7f0fe2f67f0fc70b8b8bd17910b96aa9b8e182ff3845',
+            'mixinextras-fabric-0.3.5.jar': '743bf47e4fa24642f843b9f85a5f1ba5125fb4b7e656e96b9c010a5043396047'
+        ]
+        nested.each { name, expected ->
+            def bytes = file('libs/unionclef-nested/' + name).bytes
+            if (java.security.MessageDigest.getInstance('SHA-256').digest(bytes).encodeHex().toString() != expected) {
+                throw new GradleException('Unexpected nested UnionClef artifact: ' + name)
+            }
+        }
+    }
+}
+tasks.named('compileJava') { dependsOn 'verifyUnionClef' }
+
+fabricApi.configureTests {
+    createSourceSet = true
+    modId = 'treegrow_test'
+    enableGameTests = false
+    enableClientGameTests = true
+    eula = false
+}
+dependencies { testImplementation sourceSets.gametest.output }
+
+def acceptanceScenarios = [
+    'oak-inventory-cycle': 'acceptOakInventoryCycle',
+    'birch-inventory-cycle': 'acceptBirchInventoryCycle',
+    'oak-acquire-cycle': 'acceptOakAcquireCycle',
+    'treegrow-start-entrypoints': 'acceptTreegrowStartEntrypoints',
+    'bone-meal-give-cycle': 'acceptBoneMealGiveCycle',
+    'bone-meal-no-permission': 'acceptBoneMealNoPermission',
+    'insufficient-space-rejection': 'acceptInsufficientSpaceRejection',
+    'death-cancel': 'acceptDeathCancel',
+    'sapling-unavailable': 'acceptSaplingUnavailable',
+    'site-switch-limits': 'acceptSiteSwitchLimits',
+    'world-exit-cancel': 'acceptWorldExitCancel',
+    'unsuitable-ground-no-site': 'acceptUnsuitableGroundNoSite'
+]
+def selectedScenario = providers.gradleProperty('labAcceptanceScenario')
+if (selectedScenario.isPresent() && !acceptanceScenarios.containsKey(selectedScenario.get())) {
+    throw new GradleException('Unknown labAcceptanceScenario: ' + selectedScenario.get())
+}
+loom.runs.named('clientGameTest') {
+    if(providers.gradleProperty('labSaplingHarvestProbe').isPresent()) property 'lab.saplingHarvestProbe','true'
+    property 'labAcceptanceScenario', selectedScenario.getOrElse('')
+    property 'labAcceptanceReportDir', layout.buildDirectory.dir('test-results/clientAcceptance').get().asFile.absolutePath
+    vmArg '-Xmx2G'
+    vmArg '-XX:ActiveProcessorCount=4'
+}
+acceptanceScenarios.each { scenario, taskName ->
+    tasks.register(taskName) {
+        group = 'verification'
+        description = 'Run only the real client scenario ' + scenario
+        if (selectedScenario.orNull == scenario) dependsOn 'runClientGameTest'
+        doFirst {
+            if (selectedScenario.orNull != scenario) {
+                throw new GradleException('Use -PlabAcceptanceScenario=' + scenario + ' with ' + taskName)
+            }
+        }
+    }
+}
+def prepareClientAcceptance = tasks.register('prepareClientAcceptance') {
+    group = 'verification'
+    description = 'Remove only the selected scenario report before a fresh client run'
+    doLast {
+        if (!selectedScenario.isPresent()) throw new GradleException('Select one labAcceptanceScenario explicitly')
+        // A hard client crash can bypass the test's finally block. Never leave a
+        // previous named result available as if assertions ran in this launch.
+        def report = layout.buildDirectory.file('test-results/clientAcceptance/TEST-' + selectedScenario.get() + '.xml').get().asFile
+        if (report.exists() && !report.delete()) {
+            throw new GradleException('Could not remove stale selected scenario report: ' + report)
+        }
+    }
+}
+tasks.named('runClientGameTest') {
+    dependsOn prepareClientAcceptance
+}
+
+// The delivered jar is an artifact of the result: the unit checks of the deliverables read the
+// built archive, so the test task always runs after the remapped jar exists.
+// The acceptance run reads the JUnit results of this run. An up-to-date task or a restored build
+// cache entry would leave the reports of an earlier run in place, so the task always writes fresh
+// results.
+// Gradle reports the name of a unit test method with the parameter list of the method, so the
+// report of a unit scenario names "method()" while the scenario manifest and the acceptance plan
+// name "method". The names of the reported test cases are normalized to the name of the test
+// method, so the unit scenarios and the real client scenarios use the same naming and the
+// acceptance run finds every named test case of every scenario.
+def normalizeJUnitNames = tasks.register('normalizeJUnitNames') {
+    group = 'verification'
+    description = 'Report the unit test cases with the name of the test method'
+    def results = layout.buildDirectory.dir('test-results/test')
+    outputs.upToDateWhen { false }
+    doLast {
+        def directory = results.get().asFile
+        if (!directory.isDirectory()) return
+        def pattern = java.util.regex.Pattern.compile('(<testcase name="[^"]*?)\\(\\)"')
+        def files = directory.listFiles()?.findAll { it.name ==~ /(?i)TEST-.*\.xml/ } ?: []
+        files.each { file ->
+            def text = file.getText('UTF-8')
+            def updated = pattern.matcher(text).replaceAll('$1"')
+            if (updated != text) file.write(updated, 'UTF-8')
+        }
+    }}
+tasks.named('test') {
+    dependsOn 'remapJar'
+    outputs.upToDateWhen { false }
+    outputs.cacheIf { false }
+    finalizedBy normalizeJUnitNames
+}
+
+// Maintenance regression only: run the exact installed optional combat addon.
+dependencies { modLocalRuntime files('libs/auto-defense-0.1.0.jar') }
+loom.runs.named('clientGameTest') {
+    if(providers.gradleProperty('labMiningOwnershipProbe').isPresent()) property 'lab.miningOwnershipProbe','true'
+    property 'lab.miningOwnershipMode',providers.gradleProperty('labMiningOwnershipMode').getOrElse('unlocked')
+}
