+    /**
+     * Describes why the server does not see a single grown tree, or {@code null} when it does.
+     *
+     * <p>The rule about a grown tree is the shared rule of the addon, so the addon and this check
+     * cannot disagree about a tree that grew. The checks around it stay independent of the addon:
+     * the whole cleared ground plane must hold exactly one tree and no second planted sapling.
+     */
+    private static String treeProblem(TestSingleplayerContext game, BlockPos root, Block log, Block leaf) {
+        String[] problem = new String[1];
+        game.getServer().runOnServer(server -> {
+            var world = server.getOverworld();
+            TreeGeometry.Grid grid = pos -> {
+                var state = world.getBlockState(new BlockPos(pos.x(), pos.y(), pos.z()));
+                if (state.isAir()) return TreeGeometry.Cell.AIR;
+                if (state.isOf(Blocks.OAK_LOG)) return TreeGeometry.Cell.OAK_LOG;
+                if (state.isOf(Blocks.BIRCH_LOG)) return TreeGeometry.Cell.BIRCH_LOG;
+                if (state.isOf(Blocks.OAK_LEAVES)) return TreeGeometry.Cell.OAK_LEAVES;
+                if (state.isOf(Blocks.BIRCH_LEAVES)) return TreeGeometry.Cell.BIRCH_LEAVES;
+                return TreeGeometry.Cell.OTHER;
+            };
+            var species = leaf == Blocks.BIRCH_LEAVES ? TreeGeometry.Species.BIRCH : TreeGeometry.Species.OAK;
+            var rootPos = new TreeGeometry.Pos(root.getX(), root.getY(), root.getZ());
+            if (!TreeGeometry.grownTree(grid, rootPos, species)) {
+                problem[0] = "the new trunk or crown is missing at the selected root";
+            }
+            // The whole cleared ground plane: a second tree or planted sapling must fail,
+            // even if the production task resets its per-site counters or changes its site.
+            int rootedTrunks = 0, remainingSaplings = 0;
+            for (BlockPos p : BlockPos.iterate(-16, -60, -16, 16, -60, 16)) {
+                var state = world.getBlockState(p);
+                if (state.isOf(Blocks.OAK_LOG) || state.isOf(Blocks.BIRCH_LOG)) {
+                    rootedTrunks++;
+                    if (!p.equals(root) || !state.isOf(log)) {
+                        problem[0] = "only the selected species and root may grow";
+                        break;
+                    }
+                }
+                if (state.isOf(Blocks.OAK_SAPLING) || state.isOf(Blocks.BIRCH_SAPLING)) remainingSaplings++;
+            }
+            if (problem[0] == null && rootedTrunks != 1) problem[0] = "exactly one tree must grow";
+            if (problem[0] == null && remainingSaplings != 0) problem[0] = "no additional planted saplings may remain";
+        });
+        return problem[0];
+    }
+
+    /**
+     * Checks the documented site criteria in the state of the world from before the run: suitable
+     * ground, the free volume above the root and a companion cell that the player can stand on.
+     *
+     * <p>The free volume is read from the snapshot that was taken before the task acted. The task
+     * plants its sapling in the root itself, so the state after the run would report that planted
+     * sapling as a blocked cell of the free volume.
+     */
+    private static String siteProblem(Map<String, String> before, BlockPos root, TestSingleplayerContext game) {
+        String soil = before.get(position(root.down()));
+        if (soil == null || !SoilBlocks.isSoilId(soil)) {
+            return "the ground under the root is not a soil block: " + soil;
+        }
+        for (int dy = 0; dy < 9; dy++) {
+            for (int dx = -2; dx <= 2; dx++) {
+                for (int dz = -2; dz <= 2; dz++) {
+                    BlockPos cell = root.add(dx, dy, dz);
+                    if (before.containsKey(position(cell))) {
+                        return "the free space above the root is blocked at " + cell;
+                    }
+                }
+            }
+        }
+        boolean companion = false;
+        for (Direction direction : Direction.Type.HORIZONTAL) {
+            BlockPos cell = root.offset(direction, 2);
+            if (before.containsKey(position(cell)) || before.containsKey(position(cell.up()))) continue;
+            if (!solidSupport(game, cell.down())) continue;
+            companion = true;
+            break;
+        }
+        if (!companion) return "no companion cell with a solid support next to the root";
+        return null;
+    }
