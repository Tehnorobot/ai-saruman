-    private static boolean stopAcquisitionChild(ClientGameTestContext context) {
-        return context.computeOnClient(client -> {
-            var chain = AltoClef.getInstance().getUserTaskChain();
-            for (var entry : chain.getTasks()) {
-                if (entry instanceof MineAndCollectTask child && !child.isFinished()) {
