+package lab.treegrow.mixin;
+
+import adris.altoclef.AltoClef;
+import adris.altoclef.tasks.construction.DestroyBlockTask;
+import lab.treegrow.LeafMiningTarget;
+import lab.treegrow.SaplingHarvestTools;
+import lab.treegrow.TreeGrowClient;
+import net.minecraft.util.math.BlockPos;
+import org.spongepowered.asm.mixin.Final;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+/** Change tool selection only for the exact active sapling-harvesting child. */
+@Mixin(value=DestroyBlockTask.class, remap=false)
+public abstract class SaplingMiningTaskMixin implements LeafMiningTarget {
+    @Shadow @Final private BlockPos pos;
+
+    @Override public BlockPos treegrow$miningTarget() {return pos;}
+
+    @Inject(method="equipBestToolFor", at=@At("HEAD"), cancellable=true, require=1)
+    private static void treegrow$stableSaplingHand(AltoClef mod,BlockPos target,CallbackInfo callback) {
