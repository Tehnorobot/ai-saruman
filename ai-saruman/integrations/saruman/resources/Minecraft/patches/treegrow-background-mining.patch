-    private void runEntrypoints(ClientGameTestContext context, CheckpointLog checks) {
-        GrowTreeTask before = context.computeOnClient(client -> TreeGrowClient.current());
-        context.runOnClient(client -> {
-            require(!AltoClef.getInstance().getUserTaskChain().isActive(), "initial scheduler is free");
-            executeClientCommand("treegrow start");
-        });
-        GrowTreeTask fromChat = context.computeOnClient(client -> TreeGrowClient.current());
-        checkpoint(checks, ClientScenarios.Role.CHAT_START, () -> {
-            boolean created = context.computeOnClient(client ->
-                    fromChat != null && fromChat != before && !fromChat.isFinished());
-            require(created, "the chat command must create a new tree task");
-            boolean owned = context.computeOnClient(client ->
-                    AltoClef.getInstance().getUserTaskChain().getCurrentTask() == fromChat);
-            require(owned, "the chat command must hand the identical task to the installed UnionClef");
-        });
-        context.waitTicks(8);
-        context.runOnClient(client -> executeClientCommand("treegrow stop"));
-        context.waitFor(client -> !AltoClef.getInstance().getUserTaskChain().isActive(), 40);
-        checkpoint(checks, ClientScenarios.Role.CHAT_STOP, () -> {
-            boolean cancelled = context.computeOnClient(client -> fromChat.isFinished());
-            require(cancelled, "the chat stop must cancel the task");
-            boolean released = context.computeOnClient(client ->
-                    AltoClef.getInstance().getUserTaskChain().getCurrentTask() != fromChat);
-            require(released, "the chat stop must release the scheduler");
-        });
-
-        var address = context.computeOnClient(client -> {
-            var gateway = AltoClef.getInstance().getGateway();
-            require(gateway != null && gateway.getListeningPort() > 0, "installed UnionClef gateway is listening");
-            return new java.net.InetSocketAddress(gateway.getAddress(), gateway.getListeningPort());
-        });
-        String prefix = context.computeOnClient(client -> AltoClef.getCommandExecutor().getCommandPrefix());
-        // Genuine TCP call into the existing Py4J entry point; no direct Java invocation.
-        // Blocking IO stays on the test orchestration thread, outside the client tick.
-        Py4jCommandConnection.execute(address, prefix + "treegrow start");
-        context.waitFor(client -> TreeGrowClient.current() != fromChat, 80);
-        GrowTreeTask external = context.computeOnClient(client -> TreeGrowClient.current());
-        checkpoint(checks, ClientScenarios.Role.EXTERNAL_START, () -> {
-            boolean created = context.computeOnClient(client -> external != null && external != before
