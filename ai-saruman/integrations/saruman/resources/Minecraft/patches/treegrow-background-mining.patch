+    /** The column of the fixture that closes the free space above the launch point. */
+    private static boolean inClosedVolume(BlockPos p) {
+        return p.getY() == -52 && p.getX() >= -3 && p.getX() <= 3 && p.getZ() >= -6 && p.getZ() <= 0;
+    }
+
+    /**
+     * Whether the free volume the site criteria require around the root reaches into the closed
+     * volume of the fixture. Such a site has to be rejected for lack of space.
+     */
+    private static boolean volumeTouchesClosedVolume(BlockPos root) {
+        boolean xOverlap = root.getX() - 2 <= 3 && root.getX() + 2 >= -3;
+        boolean zOverlap = root.getZ() - 2 <= 0 && root.getZ() + 2 >= -6;
+        boolean yOverlap = root.getY() <= -52 && root.getY() + 8 >= -52;
+        return xOverlap && zOverlap && yOverlap;
+    }
