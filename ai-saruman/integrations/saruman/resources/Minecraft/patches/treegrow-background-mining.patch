+     * <p>The volume of the site must be empty before the task acts: the task plants its sapling in
+     * the root itself, so the state after the run reports that sapling as an occupied cell.
+     */
+    private static List<String> occupiedBefore(Map<String, String> before, BlockPos root) {
+        List<String> occupied = new ArrayList<>();
+        for (int dy = 0; dy < 9; dy++) {
+            for (int dx = -2; dx <= 2; dx++) {
+                for (int dz = -2; dz <= 2; dz++) {
+                    BlockPos cell = root.add(dx, dy, dz);
+                    String block = before.get(position(cell));
+                    if (block != null) occupied.add(cell + "=" + block);
+                }
+            }
+        }
+        return occupied;
+    }
