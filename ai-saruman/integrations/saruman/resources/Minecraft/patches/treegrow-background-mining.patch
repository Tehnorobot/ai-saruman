+        final boolean fixtureStopped = stoppedByFixture;
+        checkpoint(checks, ClientScenarios.Role.SAPLING_UNAVAILABLE, () -> {
+            require(running, "the task must run before it can end without a sapling");
+            require(endedRun, "the task must end when no supported sapling is available, acquisition: "
+                    + (fixtureStopped ? "stopped by the fixture" : "ended by the environment"));
+            require(!task.success(), "a run without a sapling must not report a grown tree");
