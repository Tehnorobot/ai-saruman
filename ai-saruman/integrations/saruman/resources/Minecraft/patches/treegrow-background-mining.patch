+    private static boolean regionEmpty(net.minecraft.client.MinecraftClient client, boolean blockedCeiling) {
+        for (BlockPos p : BlockPos.iterate(-12, -60, -12, 12, -48, 12)) {
+            // The closed volume of the fixture is declared by the scenario itself.
+            if (blockedCeiling && inClosedVolume(p)) continue;
