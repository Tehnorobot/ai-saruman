+    /** The number the state line carries after the given key, {@code -1} when there is none. */
+    private static int numberAfter(String state, String key) {
+        int start = state.indexOf(key);
+        if (start < 0) return -1;
+        int from = start + key.length();
+        int to = from;
+        while (to < state.length() && Character.isDigit(state.charAt(to))) to++;
+        if (to == from) return -1;
+        return Integer.parseInt(state.substring(from, to));
+    }
