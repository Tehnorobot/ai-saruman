+package dev.autodefense.combat;
+
+/** Client-thread lifecycle boundary implemented by the pinned MobDefenseChain mixin. */
+public interface NativeDefenseReset {
+    /** Stop only native mob-defense work and forget targets/routes from its previous session. */
+    void autoDefenseResetNativeState();
+
+    /** Observe world/body identity even when the addon is disabled and no runner is ticking. */
+    void autoDefenseObserveWorld(Object world, Object player);
+}
