 import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.Unique;
 import org.spongepowered.asm.mixin.injection.At;
 import org.spongepowered.asm.mixin.injection.Inject;
 import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
 
 /** getPriority itself drives combat in this pinned UnionClef, before chain arbitration. */
 @Mixin(value = MobDefenseChain.class, remap = false)
-public abstract class MobDefenseOwnershipMixin {
+public abstract class MobDefenseOwnershipMixin extends SingleTaskChain implements NativeDefenseReset {
+    @Shadow public Task _killTask;
+    @Shadow private Entity targetEntity;
+    @Shadow private Entity lockedOnEntity;
+    @Shadow private CustomBaritoneGoalTask runAwayTask;
+    @Shadow private BlockPos fleeAnchor;
+    @Shadow private boolean needsChangeOnAttack;
+    @Shadow private boolean doingFunkyStuff;
+    @Shadow private boolean wasPuttingOutFire;
+    @Shadow private Vec3d suggestedArrowPos;
+    @Shadow private Vec3d suggestedArrowVel;
+    @Shadow private int suggestedDodgeTicks;
+    @Shadow private long tungstenDrivingMs;
+    @Shadow private float cachedLastPriority;
+    @Shadow private static boolean shielding;
+    @Unique private final NativeWorldScope autoDefenseScope = new NativeWorldScope();
+
+    protected MobDefenseOwnershipMixin(TaskRunner runner) { super(runner); }
+
     @Inject(method = "getPriority", at = @At("HEAD"), cancellable = true, require = 1)
     private void autoDefenseOwnsControls(CallbackInfoReturnable<Float> result) {
+        // START tick registration order is not an ownership guarantee. The dependency may
+        // evaluate priority before our independent world observer on the first new-world tick.
+        var mod = AltoClef.getInstance();
+        if (mod != null) autoDefenseObserveWorld(mod.getWorld(), mod.getPlayer());
         if (AutoDefenseClient.combat().ownsControls()) result.setReturnValue(Float.NEGATIVE_INFINITY);
     }
+
+    @Inject(method = "getPriority", at = @At("RETURN"), require = 1)
+    private void autoDefenseDropIdleTask(CallbackInfoReturnable<Float> result) {
+        // MobDefenseChain.isActive() is always true in this pinned dependency. A zero-priority
+        // chain can therefore keep ticking its previous KillEntitiesTask, whose missing-target
+        // child wanders forever. No current threat means no retained physical task.
+        if (result.getReturnValue() <= 0 && mainTask != null) autoDefenseDetachTask();
+    }
+
+    @Override public void autoDefenseObserveWorld(Object world, Object player) {
+        if (autoDefenseScope.changed(world, player)) autoDefenseResetNativeState();
+    }
+
+    @Override public void autoDefenseResetNativeState() {
+        try {
+            autoDefenseDetachTask();
+        } finally {
+            // These cached intents can reinstall a task after mainTask has been stopped.
+            // Resetting only the root does not prevent cross-world pursuit.
+            _killTask = null;
+            targetEntity = null;
+            lockedOnEntity = null;
+            runAwayTask = null;
+            fleeAnchor = null;
+            needsChangeOnAttack = false;
+            doingFunkyStuff = false;
+            wasPuttingOutFire = false;
+            suggestedArrowPos = null;
+            suggestedArrowVel = null;
+            suggestedDodgeTicks = 0;
+            tungstenDrivingMs = 0;
+            cachedLastPriority = 0;
+            shielding = false;
+        }
+    }
+
+    @Unique private void autoDefenseDetachTask() {
+        try {
+            // TaskChain.stop clears the visible child chain and calls native Task.stop(),
+            // retaining the dependency's normal release path for navigation and inputs.
+            stop();
+        } catch (Throwable failure) {
+            // Teardown may run after world unload. A failed stop must never retain its root.
+            System.out.println("LAB_CONTROL_TRACE event=native-defense-stop-failed error=" + failure);
+        } finally {
+            mainTask = null;
+            _killTask = null;
+            getTasks().clear();
+        }
+    }
 }
