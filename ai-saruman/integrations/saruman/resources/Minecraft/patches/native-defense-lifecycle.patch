+package dev.autodefense.combat;
+
+import java.io.IOException;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.MethodInsnNode;
+import static org.junit.jupiter.api.Assertions.*;
+
+/** Identity and exact pinned ABI checks; these do not claim gameplay verification. */
+final class NativeDefenseLifecycleTest {
+    @Test void unchangedWorldAndBodyRetainTheirScope() {
+        var scope = new NativeWorldScope();
+        Object world = new Object(), body = new Object();
+        assertFalse(scope.changed(null, null));
+        assertTrue(scope.changed(world, body));
+        assertFalse(scope.changed(world, body));
+    }
+
+    @Test void disconnectAndReentryAreDifferentEvenWhenNamesWouldMatch() {
+        var scope = new NativeWorldScope();
+        Object world = new String("same-world"), body = new Object();
+        scope.changed(world, body);
+        assertTrue(scope.changed(null, null));
+        assertFalse(scope.changed(null, null));
+        assertTrue(scope.changed(new String("same-world"), body));
+    }
+
+    @Test void respawnAndDimensionChangeInvalidateTheScopeSeparately() {
+        var scope = new NativeWorldScope();
+        Object world = new Object(), body = new Object();
+        scope.changed(world, body);
+        Object respawn = new Object();
+        assertTrue(scope.changed(world, respawn));
+        assertTrue(scope.changed(new Object(), respawn));
+    }
+
+    @Test void pinnedNativeFieldsMatchTheTypedReset() throws IOException {
+        var node = read("adris/altoclef/chains/MobDefenseChain");
+        for (var entry : Map.ofEntries(
+                Map.entry("_killTask", "Ladris/altoclef/tasksystem/Task;"),
+                Map.entry("targetEntity", "Lnet/minecraft/entity/Entity;"),
+                Map.entry("lockedOnEntity", "Lnet/minecraft/entity/Entity;"),
+                Map.entry("runAwayTask", "Ladris/altoclef/tasks/movement/CustomBaritoneGoalTask;"),
+                Map.entry("fleeAnchor", "Lnet/minecraft/util/math/BlockPos;"),
+                Map.entry("needsChangeOnAttack", "Z"), Map.entry("doingFunkyStuff", "Z"),
+                Map.entry("wasPuttingOutFire", "Z"), Map.entry("shielding", "Z"),
+                Map.entry("suggestedArrowPos", "Lnet/minecraft/util/math/Vec3d;"),
+                Map.entry("suggestedArrowVel", "Lnet/minecraft/util/math/Vec3d;"),
+                Map.entry("suggestedDodgeTicks", "I"), Map.entry("tungstenDrivingMs", "J"),
+                Map.entry("cachedLastPriority", "F")).entrySet()) {
+            assertTrue(node.fields.stream().anyMatch(f -> f.name.equals(entry.getKey())
+                    && f.desc.equals(entry.getValue())), "Changed native ABI: " + entry);
+        }
+        assertEquals("adris/altoclef/chains/SingleTaskChain", node.superName);
+        var parent = read(node.superName);
+        assertTrue(parent.fields.stream().anyMatch(f -> f.name.equals("mainTask")
+                && f.desc.equals("Ladris/altoclef/tasksystem/Task;")));
+        assertTrue(read("adris/altoclef/tasksystem/TaskChain").methods.stream()
+                .anyMatch(m -> m.name.equals("stop") && m.desc.equals("()V")));
+    }
+
+    @Test void resetRunsBeforeTheAddonInstallsItsNewTask() throws IOException {
+        var combat = read("dev/autodefense/combat/AutoCombat");
+        var acquire = combat.methods.stream().filter(m -> m.name.equals("acquire")).findFirst().orElseThrow();
+        int reset = -1, publish = -1, index = 0;
+        for (var instruction : acquire.instructions) {
+            if (instruction instanceof MethodInsnNode method) {
+                if (method.name.equals("resetNativeDefense")) reset = index;
+                if (method.name.equals("setChainTask")) publish = index;
+            }
+            index++;
+        }
+        assertTrue(reset >= 0 && publish > reset,
+                "The old native task must release navigation before the addon publishes its task");
+    }
+
+    private static ClassNode read(String name) throws IOException {
+        try (var stream = NativeDefenseLifecycleTest.class.getClassLoader().getResourceAsStream(name + ".class")) {
+            assertNotNull(stream, name);
+            var node = new ClassNode();
+            new ClassReader(stream).accept(node, 0);
+            return node;
+        }
+    }
+}
