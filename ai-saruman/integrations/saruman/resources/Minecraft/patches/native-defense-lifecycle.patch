+package dev.autodefense.combat;
+
+/** Identity, not world name or coordinates, determines whether native work can be retained. */
+public final class NativeWorldScope {
+    private Object world;
+    private Object player;
+
+    public boolean changed(Object nextWorld, Object nextPlayer) {
+        if (world == nextWorld && player == nextPlayer) return false;
+        world = nextWorld;
+        player = nextPlayer;
+        return true;
+    }
+}
