+package dev.autodefense.combat;
+
+import adris.altoclef.AltoClef;
+import adris.altoclef.tasks.entity.KillEntitiesTask;
+import adris.altoclef.tasks.movement.RunAwayFromHostilesTask;
+import adris.altoclef.tasksystem.Task;
+import dev.autodefense.AutoDefenseClient;
+import dev.autodefense.acceptance.AddonControl;
+import dev.autodefense.acceptance.AssertionReport;
+import dev.autodefense.settings.AutoDefenseConfig;
+import java.nio.file.Path;
+import java.util.UUID;
+import net.fabricmc.fabric.api.client.gametest.v1.FabricClientGameTest;
+import net.fabricmc.fabric.api.client.gametest.v1.context.ClientGameTestContext;
+import net.fabricmc.fabric.api.client.gametest.v1.context.TestServerContext;
+import net.minecraft.block.Blocks;
+import net.minecraft.entity.Entity;
+import net.minecraft.entity.EntityType;
+import net.minecraft.entity.SpawnReason;
+import net.minecraft.entity.mob.HuskEntity;
+import net.minecraft.item.ItemStack;
+import net.minecraft.item.Items;
+import net.minecraft.util.math.BlockPos;
+import net.minecraft.world.GameMode;
+import net.minecraft.world.rule.GameRules;
+
+/** Isolated maintenance diagnostic, not a replacement for any canonical acceptance scenario. */
+@SuppressWarnings("UnstableApiUsage")
+public final class NativeDefenseLifecycleProbe implements FabricClientGameTest {
+    private static final String SCENARIO = "native-defense-lifecycle";
+
+    @Override public void runTest(ClientGameTestContext context) {
+        if (!SCENARIO.equals(System.getProperty("labAcceptanceScenario"))) return;
+        var report = new AssertionReport(getClass().getName());
+        report.writeTo(Path.of(System.getProperty("labAcceptanceReport")));
+        System.out.println("LAB_ACCEPTANCE_BEGIN:" + SCENARIO);
+        try {
+            try (var world = context.worldBuilder().create()) {
+                context.waitFor(client -> client.world != null && client.player != null);
+                prepare(world.getServer(), context.computeOnClient(client -> client.player.getUuid()));
+                world.getClientWorld().waitForChunksRender();
+                context.runOnClient(client -> {
+                    AutoDefenseClient.combat().disable(client);
+                    AutoDefenseClient.resetNativeDefense();
+                });
+                report.check("zeroPriorityStopsActualMissingTargetKillTask", () -> {
+                    context.runOnClient(client -> {
+                        var mod = AltoClef.getInstance();
+                        var chain = mod.getMobDefenseChain();
+                        chain.setTask(new KillEntitiesTask(entity -> false, HuskEntity.class));
+                        mod.getTaskRunner().enable();
+                        require(chain.getPriority() <= 0, "The no-threat fixture has positive priority");
+                        require(chain.getCurrentTask() == null, "Zero priority retained the real kill task");
+                    });
+                    for (int tick = 0; tick < 25; tick++) {
+                        context.waitTick();
+                        context.runOnClient(client -> require(
+                                AltoClef.getInstance().getMobDefenseChain().getCurrentTask() == null,
+                                "A missing-target wander task returned without a threat"));
+                    }
+                });
+                report.requireSuccess();
+                report.check("idleCleanupPreservesAnIndependentUserTask", () -> {
+                    var user = new CountingTask(false);
+                    context.runOnClient(client -> {
+                        var mod = AltoClef.getInstance();
+                        mod.getMobDefenseChain().setTask(new KillEntitiesTask(entity -> false, HuskEntity.class));
+                        mod.runUserTask(user);
+                    });
+                    for (int tick = 0; tick < 8; tick++) context.waitTick();
+                    context.runOnClient(client -> {
+                        var mod = AltoClef.getInstance();
+                        require(mod.getUserTaskChain().getCurrentTask() == user && user.ticks > 0,
+                                "Native cleanup cancelled the user's task or prevented its ticks");
+                        require(mod.getTaskRunner().isActive(), "Native idle cleanup disabled the runner");
+                        mod.getUserTaskChain().setTask(null);
+                    });
+                });
+                report.requireSuccess();
+                report.check("failedNativeStopStillDetachesRootAndCachedIntent", () -> {
+                    context.runOnClient(client -> {
+                        var mod = AltoClef.getInstance();
+                        mod.getTaskRunner().disable();
+                        var chain = mod.getMobDefenseChain();
+                        var broken = new CountingTask(true);
+                        chain.setTask(broken);
+                        chain._killTask = broken;
+                        put(chain, "runAwayTask", new RunAwayFromHostilesTask(30, true));
+                        AutoDefenseClient.resetNativeDefense();
+                        require(broken.stops == 1, "The failing native stop was never exercised");
+                        requireEmpty(chain);
+                    });
+                });
+                report.requireSuccess();
+                // Seed while the addon and runner are disabled. The disconnect/world observer,
+                // rather than ordinary priority evaluation, must remove these cached intents.
+                context.runOnClient(client -> {
+                    var chain = AltoClef.getInstance().getMobDefenseChain();
+                    chain.setTask(new KillEntitiesTask(entity -> false, HuskEntity.class));
+                    chain._killTask = chain.getCurrentTask();
+                    put(chain, "runAwayTask", new RunAwayFromHostilesTask(30, true));
+                    require(!AutoDefenseClient.combat().isEnabled(), "The fixture enabled the addon");
+                });
+            }
+            report.check("disconnectClearsNativeWorkWhileAddonIsDisabled", () -> {
+                context.waitFor(client -> client.world == null && client.player == null);
+                context.runOnClient(client -> requireEmpty(AltoClef.getInstance().getMobDefenseChain()));
+            });
+            report.requireSuccess();
+            try (var world = context.worldBuilder().create()) {
+                context.waitFor(client -> client.world != null && client.player != null);
+                UUID player = context.computeOnClient(client -> client.player.getUuid());
+                prepare(world.getServer(), player);
+                world.getClientWorld().waitForChunksRender();
+                report.check("newWorldHasNoInheritedNativeTask", () -> context.runOnClient(client -> {
+                    require(!AutoDefenseClient.combat().isEnabled(), "World entry rearmed the addon");
+                    requireEmpty(AltoClef.getInstance().getMobDefenseChain());
+                }));
+                report.requireSuccess();
+                UUID hostile = spawn(world.getServer(), player);
+                context.waitFor(client -> client.world.getEntity(hostile) != null);
+                report.check("explicitStartStillAttacksANewRealThreat", () -> {
+                    context.runOnClient(client -> {
+                        AddonControl.forceMode(client, AutoDefenseConfig.MODE_SEARCH);
+                        AutoDefenseClient.combat().enable(client);
+                    });
+                    context.waitFor(client -> hostile.equals(AutoDefenseClient.combat().targetId()), 200);
+                    context.waitFor(client -> {
+                        Entity target = client.world.getEntity(hostile);
+                        return target instanceof HuskEntity husk && husk.getHealth() < 20;
+                    }, 400);
+                    context.runOnClient(client -> AutoDefenseClient.combat().stop(client));
+                });
+            }
+        } catch (Throwable failure) {
+            report.lifecycleError(failure);
+        } finally {
+            System.out.println("LAB_ACCEPTANCE_END:" + SCENARIO);
+        }
+        report.requireSuccess();
+    }
+
+    private static void prepare(TestServerContext server, UUID playerId) {
+        server.runOnServer(game -> {
+            var player = game.getPlayerManager().getPlayer(playerId);
+            var level = player.getEntityWorld();
+            level.getGameRules().setValue(GameRules.DO_MOB_SPAWNING, false, game);
+            player.changeGameMode(GameMode.SURVIVAL);
+            player.setHealth(20);
+            player.getHungerManager().setFoodLevel(20);
+            player.getInventory().clear();
+            player.getInventory().setStack(0, new ItemStack(Items.IRON_SWORD));
+            player.getInventory().setStack(1, new ItemStack(Items.BREAD, 16));
+            BlockPos origin = player.getBlockPos();
+            for (int x = -8; x <= 8; x++) for (int z = -8; z <= 8; z++) {
+                level.setBlockState(origin.add(x, -1, z), Blocks.STONE.getDefaultState());
+                for (int y = 0; y < 4; y++) level.setBlockState(origin.add(x, y, z), Blocks.AIR.getDefaultState());
+            }
+            for (var entity : java.util.stream.StreamSupport.stream(level.iterateEntities().spliterator(), false).toList()) {
+                if (!(entity instanceof net.minecraft.server.network.ServerPlayerEntity)) entity.discard();
+            }
+        });
+    }
+
+    private static UUID spawn(TestServerContext server, UUID playerId) {
+        return server.computeOnServer(game -> {
+            var player = game.getPlayerManager().getPlayer(playerId);
+            var level = player.getEntityWorld();
+            var hostile = EntityType.HUSK.create(level, SpawnReason.COMMAND);
+            require(hostile != null, "No fixture hostile");
+            hostile.setAiDisabled(true);
+            hostile.refreshPositionAndAngles(player.getX() + 3, player.getY(), player.getZ(), 0, 0);
+            require(level.spawnEntity(hostile), "Hostile did not spawn");
+            return hostile.getUuid();
+        });
+    }
+
+    private static void requireEmpty(adris.altoclef.chains.MobDefenseChain chain) {
+        require(chain.getCurrentTask() == null && chain._killTask == null && chain.getTasks().isEmpty(),
+                "The native task/child chain was retained");
+        for (String name : new String[]{"runAwayTask", "lockedOnEntity", "targetEntity", "fleeAnchor",
+                "suggestedArrowPos", "suggestedArrowVel"}) require(read(chain, name) == null, "Retained intent: " + name);
+    }
+
+    private static Object read(Object value, String name) {
+        try {
+            var field = value.getClass().getDeclaredField(name);
+            field.setAccessible(true);
+            return field.get(value);
+        } catch (ReflectiveOperationException failure) { throw new AssertionError(failure); }
+    }
+
+    private static void put(Object value, String name, Object replacement) {
+        try {
+            var field = value.getClass().getDeclaredField(name);
+            field.setAccessible(true);
+            field.set(value, replacement);
+        } catch (ReflectiveOperationException failure) { throw new AssertionError(failure); }
+    }
+
+    private static void require(boolean condition, String message) {
+        if (!condition) throw new AssertionError(message);
+    }
+
+    private static final class CountingTask extends Task {
+        private final boolean failStop;
+        int ticks, stops;
+        CountingTask(boolean failStop) { this.failStop = failStop; }
+        @Override protected void onStart() { }
+        @Override protected Task onTick() { ticks++; return null; }
+        @Override public void stop() { stops++; if (failStop) throw new IllegalStateException("diagnostic-stop-failure"); super.stop(); }
+        @Override protected void onStop(Task next) { }
+        @Override protected boolean isEqual(Task other) { return this == other; }
+        @Override protected String toDebugString() { return "Native defense lifecycle diagnostic"; }
+    }
