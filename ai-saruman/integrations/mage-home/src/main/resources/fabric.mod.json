{
  "schemaVersion": 1,
  "id": "mage_home",
  "version": "${version}",
  "name": "Mage Home",
  "description": "Builds the house of the project automatically with UnionClef on the client.",
  "authors": [
    "mage_home"
  ],
  "license": "MIT",
  "environment": "client",
  "mixins": ["mage_home.mixins.json"],
  "entrypoints": {
