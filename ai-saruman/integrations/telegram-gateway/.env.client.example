# PC ONLY: copy to .env.client. This client does not need a Telegram bot token.
# For initial tests, use an SSH tunnel to the VPS.
GATEWAY_URL=http://127.0.0.1:8787
GATEWAY_API_KEY=
# Optional managed SSH tunnel. Leave empty to keep using a manually opened tunnel.
# Requires a verified host key and working key login (no interactive password).
GATEWAY_SSH_HOST=
GATEWAY_SSH_PORT=22
GATEWAY_SSH_USER=root
GATEWAY_SSH_IDENTITY_FILE=
