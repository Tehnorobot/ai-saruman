# Credentials only in .env on your PC, never include in a ZIP or Git.
# Codex CLI normally authenticates via device login with ChatGPT.
# If you choose API authentication separately, uncomment OPENAI_API_KEY.
# OPENAI_API_KEY=

# Optional paid Claude API via DSLab. The real API key goes ONLY to provider-gateway.
DSLAB_API_KEY=
DSLAB_BASE_URL=https://api.dslab.tech

# Optional LiteLLM proxy. Public HTTPS endpoint; credentials stay in gateway.
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Optional MiniMax Explore / M Plan. Use the Subscription Key from Plan Details,
# not a pay-as-you-go API Key. Credentials are passed ONLY to provider-gateway.
# MiniMax-M3.1-Flash: default=max; low/medium/high/xhigh/max supported.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
# Generate a separate random control secret (at least 32 characters).
# Keep it stable: changing it can prevent recovery of pending attempts.
DSLAB_CONTROL_TOKEN=

# Yandex Cloud Object Storage (S3-compatible), optional until configured.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
YC_S3_BUCKET=
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_REGION=ru-central1
YC_S3_PREFIX=codex-development-lab
YC_S3_PRESIGN_SECONDS=900
# Set recording duration in the dashboard: "Запись видео". Saved in SQLite.

# Explicit consent required for Minecraft client game tests; see Minecraft EULA.
MINECRAFT_EULA_ACCEPTED=false

# Bounded autonomous cycles before stopping and asking for a new run.
MAX_AGENT_ROUNDS=5
QUOTA_RECHECK_SECONDS=900
# Legacy names below now configure SOFT handoff targets, never forced termination.
# After this active time the model is asked to submit findings and unresolved work.
# One model turn includes analysis, edits and supervised compilation/unit checks.
# Minecraft/asset loading belongs to the independent verification phase.
AGENT_TIMEOUT_SECONDS=3600
# Soft preparation transition only; never aborts the multi-stage cycle.
# After this active preparation time, finalize working decisions and hand off ready work.
PREPARATION_SOFT_LIMIT_SECONDS=3600
# Empty: each role inherits AGENT_TIMEOUT_SECONDS. Optional soft targets, >=60.
PLANNER_TIMEOUT_SECONDS=
REVIEWER_TIMEOUT_SECONDS=
# API conversation history target in UTF-8 bytes (not tokens). 512 KiB by default.
# Applies to DSLab, LiteLLM and MiniMax. Complete recent tool results are preserved.
API_CONTEXT_BYTES=524288
# Legacy DSLAB_CONTEXT_BYTES is supported if API_CONTEXT_BYTES is not set.
TEST_TIMEOUT_SECONDS=900
# Historical TIMEOUT checkpoints continue from saved sources without a fixed retry count.
# This is a local dashboard. Do not expose without authentication/reverse proxy.
DASHBOARD_PORT=8080
