{
  "type": "object",
  "properties": {
    "contract": {
      "const": "VerificationResult",
      "description": "Имя типа сообщения; выбирает схему."
    },
    "version": {
      "const": "v1",
      "description": "Версия формата; здесь только v1."
    },
    "scope": {
      "$ref": "#/$defs/Scope",
      "description": "Проект, версия ТЗ, версия кода и раунд."
    },
    "request_ref": {
      "$ref": "#/$defs/ArtifactRef",
      "description": "Исходный запрос этого результата."
    },
    "runner_run_id": {
      "type": "string",
      "minLength": 1,
      "description": "ID независимого запуска, назначенный исполнителем."
    },
    "build_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_EXECUTED",
        "ERROR"
      ],
      "description": "Сборка: PASS, FAIL, не выполнялась либо ошибка среды."
    },
    "scenario_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScenarioResult"
      },
      "description": "Независимые результаты сценариев."
    },
    "infrastructure_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "ID независимого запуска, назначенный исполнителем."
      },
      "description": "Ошибки среды, отдельно от неверного поведения мода."
    },
    "raw_report_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "description": "Оригинальные отчёты и журналы."
    },
    "execution_diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "diagnostic_id": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "actual": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "pattern": "^E-[a-f0-9]{64}$"
                },
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "evidence_id",
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "diagnostic_id",
          "stage",
          "label",
          "status",
          "argv",
          "exit_code",
          "actual",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract",
    "version",
    "scope",
    "request_ref",
    "runner_run_id",
    "build_status",
    "scenario_results",
    "infrastructure_errors",
    "raw_report_refs"
  ],
  "additionalProperties": false,
  "description": "Исполнитель → контроллер, планировщик и память. Наблюдения конкретного снимка.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerificationResult — runtime v1",
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Для ArtifactRef: путь относительно корня проекта; для Issue: путь поля в JSON.",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:\\x00])[^/]+(?:/[^/]+)*$"
        },
        "sha256": {
          "$ref": "#/$defs/Hash",
          "description": "Хеш точного содержимого файла; проверяется при чтении."
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "description": "MIME-тип файла."
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "additionalProperties": false
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Observation": {
      "type": "object",
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "minLength": 1,
          "description": "ID измеряемой точки."
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EXECUTED",
            "SKIPPED",
            "ERROR"
          ],
          "description": "Наблюдаемый статус; допустимые значения заданы enum."
        },
        "actual": {
          "type": "string",
          "minLength": 1,
          "description": "Фактическое наблюдение либо причина отсутствия выполнения."
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "description": "Цитаты из файлов; доверие к выводу проверяется отдельно."
        }
      },
      "required": [
        "checkpoint_id",
        "status",
        "actual",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "ScenarioResult": {
      "type": "object",
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EXECUTED",
            "SKIPPED",
            "ERROR"
          ],
          "description": "Наблюдаемый статус; допустимые значения заданы enum."
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "description": "Контрольные точки и проверяемые утверждения."
        },
        "media_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "description": "Файлы видео и изображений; не замена измерениям."
        },
        "fixture_result": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "ERROR",
                "NOT_EXECUTED"
              ]
            },
            "reason_code": {
              "type": "string",
              "enum": [
                "fixture_valid",
                "invalid_fixture",
                "fixture_unconfirmed"
              ]
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "classname": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "PASS",
                      "FAIL",
                      "NOT_EXECUTED",
                      "SKIPPED",
                      "ERROR"
                    ],
                    "description": "Наблюдаемый статус; допустимые значения заданы enum."
                  },
                  "actual": {
                    "type": "string",
                    "minLength": 1
                  },
                  "report_refs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/ArtifactRef"
                    }
                  },
                  "checkpoint_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Affected checkpoint IDs. Empty or absent means all checkpoints in this scenario; IDs must be known and distinct."
                  }
                },
                "required": [
                  "classname",
                  "name",
                  "status",
                  "actual",
                  "report_refs",
                  "checkpoint_ids"
                ],
                "additionalProperties": false
              }
            },
            "raw_checkpoints": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Observation"
              },
              "description": "Unmodified observations before an invalid or unconfirmed fixture prevented product conclusions."
            },
            "affected_checkpoint_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Resolved IDs whose product observations are NOT_EXECUTED because a declared fixture prerequisite failed or remained unconfirmed."
            }
          },
          "required": [
            "status",
            "reason_code",
            "checks",
            "raw_checkpoints",
            "affected_checkpoint_ids"
          ],
          "additionalProperties": false
        },
        "attempted": {
          "type": "boolean"
        },
        "stopped_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "execution_stage": {
          "type": "string",
          "enum": [
            "build",
            "scenario",
            "not_started"
          ]
        },
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "measurement_reused": {
          "type": "boolean"
        }
      },
      "required": [
        "scenario_id",
        "status",
        "checkpoints",
        "media_refs"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "description": "Устойчивый ID проекта."
        },
        "spec_revision": {
          "$ref": "#/$defs/Hash",
          "description": "SHA-256 канонического манифеста ТЗ и явных уточнений."
        },
        "source_revision": {
          "$ref": "#/$defs/Hash",
          "description": "SHA-256 канонического манифеста исходников снимка."
        },
        "round": {
          "type": "integer",
          "minimum": 0,
          "description": "Номер попытки; не процент готовности."
        }
      },
      "required": [
        "project_id",
        "spec_revision",
        "source_revision",
        "round"
      ],
      "additionalProperties": false
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef",
          "description": "Файл, из которого взята цитата."
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "description": "Первая строка фрагмента, с 1."
        },
        "end_line": {
          "type": "integer",
          "minimum": 1,
          "description": "Последняя строка фрагмента включительно."
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "description": "Точная цитата из указанной версии файла."
        }
      },
      "required": [
        "artifact",
        "start_line",
        "end_line",
        "excerpt"
      ],
      "additionalProperties": false
    },
    "VerificationResult": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "VerificationResult",
          "description": "Имя типа сообщения; выбирает схему."
        },
        "version": {
          "const": "v1",
          "description": "Версия формата; здесь только v1."
        },
        "scope": {
          "$ref": "#/$defs/Scope",
          "description": "Проект, версия ТЗ, версия кода и раунд."
        },
        "request_ref": {
          "$ref": "#/$defs/ArtifactRef",
          "description": "Исходный запрос этого результата."
        },
        "runner_run_id": {
          "type": "string",
          "minLength": 1,
          "description": "ID независимого запуска, назначенный исполнителем."
        },
        "build_status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EXECUTED",
            "ERROR"
          ],
          "description": "Сборка: PASS, FAIL, не выполнялась либо ошибка среды."
        },
        "scenario_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioResult"
          },
          "description": "Независимые результаты сценариев."
        },
        "infrastructure_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "ID независимого запуска, назначенный исполнителем."
          },
          "description": "Ошибки среды, отдельно от неверного поведения мода."
        },
        "raw_report_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "description": "Оригинальные отчёты и журналы."
        },
        "execution_diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "diagnostic_id": {
                "type": "string"
              },
              "stage": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "actual": {
                "type": "string"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "evidence_id": {
                      "type": "string",
                      "pattern": "^E-[a-f0-9]{64}$"
                    },
                    "path": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "evidence_id",
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "diagnostic_id",
              "stage",
              "label",
              "status",
              "argv",
              "exit_code",
              "actual",
              "evidence_refs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "contract",
        "version",
        "scope",
        "request_ref",
        "runner_run_id",
        "build_status",
        "scenario_results",
        "infrastructure_errors",
        "raw_report_refs"
      ],
      "additionalProperties": false,
      "description": "Исполнитель → контроллер, планировщик и память. Наблюдения конкретного снимка."
    }
  }
}
