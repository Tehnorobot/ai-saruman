{
  "type": "object",
  "description": "Внутренний вызов контроллера. Проверяемый JSON и доверенная схема.",
  "required": [
    "contract",
    "version",
    "scope",
    "payload_ref",
    "schema_name",
    "catalog_ref",
    "graph_ref"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "description": "Имя типа сообщения; выбирает схему.",
      "enum": [
        "ValidationRequest"
      ],
      "type": "string"
    },
    "version": {
      "description": "Версия формата; здесь только v1.",
      "enum": [
        "v1"
      ],
      "type": "string"
    },
    "scope": {
      "description": "Проект, версия ТЗ, версия кода и раунд.",
      "$ref": "#/$defs/Scope"
    },
    "payload_ref": {
      "description": "Оригинальное сообщение в файле; сохраняется без смысловой правки.",
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_name": {
      "type": "string",
      "description": "Схема из доверенного реестра.",
      "enum": [
        "RequirementsCatalog",
        "TaskGraph",
        "PlannerDecision",
        "CoderReport",
        "ScenarioManifest",
        "ReviewResult",
        "ReviewResponse",
        "CatalogPatch",
        "PreparationHandoff"
      ]
    },
    "catalog_ref": {
      "description": "Принятый каталог требований; null допустим при начальной проверке.",
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "graph_ref": {
      "description": "Принятый граф задач; null допустим при начальной проверке.",
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Для ArtifactRef: путь относительно корня проекта; для Issue: путь поля в JSON."
        },
        "sha256": {
          "description": "Хеш точного содержимого файла; проверяется при чтении.",
          "$ref": "#/$defs/Hash"
        },
        "media_type": {
          "type": "string",
          "description": "MIME-тип файла."
        }
      }
    },
    "Hash": {
      "type": "string"
    },
    "Scope": {
      "type": "object",
      "required": [
        "project_id",
        "spec_revision",
        "source_revision",
        "round"
      ],
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "description": "Устойчивый ID проекта."
        },
        "spec_revision": {
          "description": "SHA-256 канонического манифеста ТЗ и явных уточнений.",
          "$ref": "#/$defs/Hash"
        },
        "source_revision": {
          "description": "SHA-256 канонического манифеста исходников снимка.",
          "$ref": "#/$defs/Hash"
        },
        "round": {
          "type": "integer",
          "description": "Номер попытки; не процент готовности."
        }
      }
    },
    "ValidationRequest": {
      "type": "object",
      "description": "Внутренний вызов контроллера. Проверяемый JSON и доверенная схема.",
      "required": [
        "contract",
        "version",
        "scope",
        "payload_ref",
        "schema_name",
        "catalog_ref",
        "graph_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "contract": {
          "description": "Имя типа сообщения; выбирает схему.",
          "enum": [
            "ValidationRequest"
          ],
          "type": "string"
        },
        "version": {
          "description": "Версия формата; здесь только v1.",
          "enum": [
            "v1"
          ],
          "type": "string"
        },
        "scope": {
          "description": "Проект, версия ТЗ, версия кода и раунд.",
          "$ref": "#/$defs/Scope"
        },
        "payload_ref": {
          "description": "Оригинальное сообщение в файле; сохраняется без смысловой правки.",
          "$ref": "#/$defs/ArtifactRef"
        },
        "schema_name": {
          "type": "string",
          "description": "Схема из доверенного реестра.",
          "enum": [
            "RequirementsCatalog",
            "TaskGraph",
            "PlannerDecision",
            "CoderReport",
            "ScenarioManifest",
            "ReviewResult",
            "ReviewResponse",
            "CatalogPatch",
            "PreparationHandoff"
          ]
        },
        "catalog_ref": {
          "description": "Принятый каталог требований; null допустим при начальной проверке.",
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "graph_ref": {
          "description": "Принятый граф задач; null допустим при начальной проверке.",
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
