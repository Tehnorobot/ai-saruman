{
  "type": "object",
  "properties": {
    "contract": {
      "const": "TaskGraph",
      "description": "Имя типа сообщения; выбирает схему."
    },
    "version": {
      "const": "v1",
      "description": "Версия формата; здесь только v1."
    },
    "scope": {
      "$ref": "#/$defs/Scope",
      "description": "Проект, версия ТЗ, версия кода и раунд."
    },
    "catalog_ref": {
      "$ref": "#/$defs/ArtifactRef",
      "description": "Принятый каталог требований; null допустим при начальной проверке."
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Task"
      },
      "description": "Компактные функциональные задачи; число не фиксировано."
    }
  },
  "required": [
    "contract",
    "version",
    "scope",
    "catalog_ref",
    "tasks"
  ],
  "additionalProperties": false,
  "description": "LLM → контроллер. Зависимости задач; смысл проверяет LLM, циклы — алгоритм.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskGraph — runtime v1",
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Для ArtifactRef: путь относительно корня проекта; для Issue: путь поля в JSON.",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:\\x00])[^/]+(?:/[^/]+)*$"
        },
        "sha256": {
          "$ref": "#/$defs/Hash",
          "description": "Хеш точного содержимого файла; проверяется при чтении."
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "description": "MIME-тип файла."
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "additionalProperties": false
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Scope": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "description": "Устойчивый ID проекта."
        },
        "spec_revision": {
          "$ref": "#/$defs/Hash",
          "description": "SHA-256 канонического манифеста ТЗ и явных уточнений."
        },
        "source_revision": {
          "$ref": "#/$defs/Hash",
          "description": "SHA-256 канонического манифеста исходников снимка."
        },
        "round": {
          "type": "integer",
          "minimum": 0,
          "description": "Номер попытки; не процент готовности."
        }
      },
      "required": [
        "project_id",
        "spec_revision",
        "source_revision",
        "round"
      ],
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Уникальный ID внутри соответствующего каталога."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Краткое имя функции для пользователя."
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Как наблюдать результат; затем превращается в исполняемый тест."
          },
          "description": "Связанные требования; ID должны существовать."
        },
        "condition_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Как наблюдать результат; затем превращается в исполняемый тест."
          },
          "description": "Проверяемые условия; ID должны существовать."
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Как наблюдать результат; затем превращается в исполняемый тест."
          },
          "description": "Задачи-предпосылки; связи должны образовать DAG."
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "description": "Для Task: результат функции; для шлюза: завершение или ошибка."
        },
        "verification_approach": {
          "type": "string",
          "minLength": 1,
          "description": "Как наблюдать результат; затем превращается в исполняемый тест."
        }
      },
      "required": [
        "id",
        "title",
        "requirement_ids",
        "condition_ids",
        "depends_on",
        "outcome",
        "verification_approach"
      ],
      "additionalProperties": false
    },
    "TaskGraph": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "TaskGraph",
          "description": "Имя типа сообщения; выбирает схему."
        },
        "version": {
          "const": "v1",
          "description": "Версия формата; здесь только v1."
        },
        "scope": {
          "$ref": "#/$defs/Scope",
          "description": "Проект, версия ТЗ, версия кода и раунд."
        },
        "catalog_ref": {
          "$ref": "#/$defs/ArtifactRef",
          "description": "Принятый каталог требований; null допустим при начальной проверке."
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Task"
          },
          "description": "Компактные функциональные задачи; число не фиксировано."
        }
      },
      "required": [
        "contract",
        "version",
        "scope",
        "catalog_ref",
        "tasks"
      ],
      "additionalProperties": false,
      "description": "LLM → контроллер. Зависимости задач; смысл проверяет LLM, циклы — алгоритм."
    }
  }
}
