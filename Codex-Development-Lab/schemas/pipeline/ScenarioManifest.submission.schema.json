{
  "type": "object",
  "required": [
    "contract",
    "version",
    "scope",
    "scenarios"
  ],
  "additionalProperties": false,
  "description": "Кодер → ревьюер → исполнитель. Исполняемые тесты плюс явные утверждения.",
  "properties": {
    "contract": {
      "description": "Имя типа сообщения; выбирает схему.",
      "enum": [
        "ScenarioManifest"
      ],
      "type": "string"
    },
    "version": {
      "description": "Версия формата; здесь только v1.",
      "enum": [
        "v1"
      ],
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope",
      "description": "Проект, версия ТЗ, версия кода и раунд."
    },
    "scenarios": {
      "type": "array",
      "description": "Сценарии и их измеримые контрольные точки.",
      "items": {
        "$ref": "#/$defs/Scenario"
      }
    }
  },
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Для ArtifactRef: путь относительно корня проекта; для Issue: путь поля в JSON."
        },
        "sha256": {
          "$ref": "#/$defs/Hash",
          "description": "Хеш точного содержимого файла; проверяется при чтении."
        },
        "media_type": {
          "type": "string",
          "description": "MIME-тип файла."
        }
      }
    },
    "Checkpoint": {
      "type": "object",
      "required": [
        "id",
        "condition_ids",
        "assertion",
        "observable",
        "comparator",
        "expected"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Уникальный ID внутри соответствующего каталога."
        },
        "condition_ids": {
          "type": "array",
          "description": "Проверяемые условия; ID должны существовать.",
          "items": {
            "type": "string",
            "description": "Имя измеряемого состояния или события."
          }
        },
        "assertion": {
          "type": "string",
          "description": "Какое свойство проверяется."
        },
        "observable": {
          "type": "string",
          "description": "Имя измеряемого состояния или события."
        },
        "comparator": {
          "type": "string",
          "enum": [
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge",
            "contains",
            "event"
          ],
          "description": "Операция сравнения: eq равно, ne не равно; lt/le/gt/ge; contains; event."
        },
        "expected": {
          "type": [
            "string",
            "number",
            "boolean"
          ],
          "description": "Ожидаемый результат; в Checkpoint это сравниваемое значение."
        }
      }
    },
    "Hash": {
      "type": "string"
    },
    "Scenario": {
      "type": "object",
      "required": [
        "id",
        "task_ids",
        "condition_ids",
        "setup",
        "steps",
        "checkpoints",
        "test_file",
        "runner_profile",
        "media",
        "execution"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "task_ids": {
          "type": "array",
          "description": "Задачи, затронутые сообщением.",
          "items": {
            "type": "string",
            "description": "Имя доверенного профиля; не произвольная shell-команда модели."
          }
        },
        "condition_ids": {
          "type": "array",
          "description": "Проверяемые условия; ID должны существовать.",
          "items": {
            "type": "string",
            "description": "Имя доверенного профиля; не произвольная shell-команда модели."
          }
        },
        "setup": {
          "type": "array",
          "description": "Исходные условия воспроизводимого сценария.",
          "items": {
            "type": "string",
            "description": "Имя доверенного профиля; не произвольная shell-команда модели."
          }
        },
        "steps": {
          "type": "array",
          "description": "Последовательность действий.",
          "items": {
            "type": "string",
            "description": "Имя доверенного профиля; не произвольная shell-команда модели."
          }
        },
        "checkpoints": {
          "type": "array",
          "description": "Контрольные точки и проверяемые утверждения.",
          "items": {
            "$ref": "#/$defs/Checkpoint"
          }
        },
        "test_file": {
          "$ref": "#/$defs/ArtifactRef",
          "description": "Исполняемый тест. Текстовый сценарий сам не запускается."
        },
        "runner_profile": {
          "type": "string",
          "description": "Имя доверенного профиля; не произвольная shell-команда модели."
        },
        "media": {
          "type": "array",
          "description": "Какие медиа нужны сценарию; пустой массив разрешён.",
          "items": {
            "type": "string",
            "enum": [
              "video",
              "screenshot"
            ]
          }
        },
        "execution": {
          "type": "object",
          "required": [
            "kind",
            "gradle_task",
            "expected_tests",
            "checkpoint_tests",
            "precondition_tests",
            "reuse"
          ],
          "additionalProperties": false,
          "description": "Safe Gradle/JUnit binding; checkpoint status comes from these independently executed test cases.",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "gameplay",
                "unit",
                "integration"
              ]
            },
            "gradle_task": {
              "type": "string"
            },
            "expected_tests": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "classname",
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "classname": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "checkpoint_tests": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "checkpoint_id",
                  "classname",
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "checkpoint_id": {
                    "type": "string"
                  },
                  "classname": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "precondition_tests": {
              "type": "array",
              "description": "Optional scenario-wide fixture prerequisites. Name fresh JUnit setup assertions before addon actions; each must be in expected_tests and must not establish a product condition. Empty means no explicit fixture dependency. Failed or unconfirmed prerequisites leave product checks NOT_EXECUTED; originals remain archived.",
              "items": {
                "type": "object",
                "required": [
                  "classname",
                  "name",
                  "checkpoint_ids"
                ],
                "additionalProperties": false,
                "properties": {
                  "classname": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "checkpoint_ids": {
                    "type": "array",
                    "description": "Affected checkpoint IDs. Empty or absent means all checkpoints in this scenario; IDs must be known and distinct.",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "reuse": {
              "description": "Explicit reviewed consent to share identical fresh unit execution inputs. Null preserves separate runs; gameplay cannot share.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "group",
                    "profile",
                    "initial_state"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "group": {
                      "type": "string"
                    },
                    "profile": {
                      "type": "string"
                    },
                    "initial_state": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "ScenarioManifest": {
      "type": "object",
      "required": [
        "contract",
        "version",
        "scope",
        "scenarios"
      ],
      "additionalProperties": false,
      "description": "Кодер → ревьюер → исполнитель. Исполняемые тесты плюс явные утверждения.",
      "properties": {
        "contract": {
          "description": "Имя типа сообщения; выбирает схему.",
          "enum": [
            "ScenarioManifest"
          ],
          "type": "string"
        },
        "version": {
          "description": "Версия формата; здесь только v1.",
          "enum": [
            "v1"
          ],
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope",
          "description": "Проект, версия ТЗ, версия кода и раунд."
        },
        "scenarios": {
          "type": "array",
          "description": "Сценарии и их измеримые контрольные точки.",
          "items": {
            "$ref": "#/$defs/Scenario"
          }
        }
      }
    },
    "Scope": {
      "type": "object",
      "required": [
        "project_id",
        "spec_revision",
        "source_revision",
        "round"
      ],
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "description": "Устойчивый ID проекта."
        },
        "spec_revision": {
          "$ref": "#/$defs/Hash",
          "description": "SHA-256 канонического манифеста ТЗ и явных уточнений."
        },
        "source_revision": {
          "$ref": "#/$defs/Hash",
          "description": "SHA-256 канонического манифеста исходников снимка."
        },
        "round": {
          "type": "integer",
          "description": "Номер попытки; не процент готовности."
        }
      }
    }
  }
}
