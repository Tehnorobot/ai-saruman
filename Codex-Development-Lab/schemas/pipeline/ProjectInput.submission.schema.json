{
  "type": "object",
  "description": "Панель → приём ТЗ. Файл Markdown и явные уточнения.",
  "required": [
    "contract",
    "version",
    "project_id",
    "spec_file",
    "clarifications",
    "roles",
    "budget"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "description": "Имя типа сообщения; выбирает схему.",
      "enum": [
        "ProjectInput"
      ],
      "type": "string"
    },
    "version": {
      "description": "Версия формата; здесь только v1.",
      "enum": [
        "v1"
      ],
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "description": "Устойчивый ID проекта."
    },
    "spec_file": {
      "description": "Сохранённый исходный Markdown.",
      "$ref": "#/$defs/ArtifactRef"
    },
    "clarifications": {
      "type": "array",
      "description": "Явные уточнения пользователя; отдельные файлы.",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      }
    },
    "roles": {
      "type": "array",
      "description": "Настройки моделей по ролям.",
      "items": {
        "$ref": "#/$defs/RoleConfig"
      }
    },
    "budget": {
      "description": "Оставшийся пользовательский бюджет на момент запроса.",
      "$ref": "#/$defs/Budget"
    }
  },
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Для ArtifactRef: путь относительно корня проекта; для Issue: путь поля в JSON."
        },
        "sha256": {
          "description": "Хеш точного содержимого файла; проверяется при чтении.",
          "$ref": "#/$defs/Hash"
        },
        "media_type": {
          "type": "string",
          "description": "MIME-тип файла."
        }
      }
    },
    "Budget": {
      "type": "object",
      "required": [
        "remaining_tokens",
        "remaining_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "remaining_tokens": {
          "type": "integer",
          "description": "Остаток доступных токенов; пример не задаёт лимит проекта."
        },
        "remaining_seconds": {
          "type": "integer",
          "description": "Остаток разрешённого времени."
        }
      }
    },
    "Hash": {
      "type": "string"
    },
    "ProjectInput": {
      "type": "object",
      "description": "Панель → приём ТЗ. Файл Markdown и явные уточнения.",
      "required": [
        "contract",
        "version",
        "project_id",
        "spec_file",
        "clarifications",
        "roles",
        "budget"
      ],
      "additionalProperties": false,
      "properties": {
        "contract": {
          "description": "Имя типа сообщения; выбирает схему.",
          "enum": [
            "ProjectInput"
          ],
          "type": "string"
        },
        "version": {
          "description": "Версия формата; здесь только v1.",
          "enum": [
            "v1"
          ],
          "type": "string"
        },
        "project_id": {
          "type": "string",
          "description": "Устойчивый ID проекта."
        },
        "spec_file": {
          "description": "Сохранённый исходный Markdown.",
          "$ref": "#/$defs/ArtifactRef"
        },
        "clarifications": {
          "type": "array",
          "description": "Явные уточнения пользователя; отдельные файлы.",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "roles": {
          "type": "array",
          "description": "Настройки моделей по ролям.",
          "items": {
            "$ref": "#/$defs/RoleConfig"
          }
        },
        "budget": {
          "description": "Оставшийся пользовательский бюджет на момент запроса.",
          "$ref": "#/$defs/Budget"
        }
      }
    },
    "RoleConfig": {
      "type": "object",
      "required": [
        "role",
        "provider",
        "model",
        "reasoning"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "description": "Роль автора сообщения модели.",
          "enum": [
            "planner",
            "coder",
            "reviewer"
          ]
        },
        "provider": {
          "type": "string",
          "description": "Выбранный API-провайдер."
        },
        "model": {
          "type": "string",
          "description": "Точное имя модели у провайдера."
        },
        "reasoning": {
          "type": "string",
          "description": "Значение из возможностей выбранной модели; default означает штатное."
        }
      }
    }
  }
}
