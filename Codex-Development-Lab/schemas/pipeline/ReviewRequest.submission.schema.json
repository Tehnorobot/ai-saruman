{
  "type": "object",
  "description": "Контроллер → ревьюер. Независимое чтение кода, условий и тестов.",
  "required": [
    "contract",
    "version",
    "scope",
    "subject",
    "context_ref",
    "catalog_ref",
    "subject_refs",
    "diff_ref",
    "memory_index_ref",
    "focus"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "description": "Имя типа сообщения; выбирает схему.",
      "enum": [
        "ReviewRequest"
      ],
      "type": "string"
    },
    "version": {
      "description": "Версия формата; здесь только v1.",
      "enum": [
        "v1"
      ],
      "type": "string"
    },
    "scope": {
      "description": "Проект, версия ТЗ, версия кода и раунд.",
      "$ref": "#/$defs/Scope"
    },
    "subject": {
      "type": "string",
      "description": "Что рассматривает ревьюер: разбиение, план, код или тесты.",
      "enum": [
        "decomposition",
        "plan",
        "code",
        "scenarios",
        "catalog"
      ]
    },
    "context_ref": {
      "description": "Вход рассматриваемого этапа: DecompositionInput, PlannerInput или CoderAssignment.",
      "$ref": "#/$defs/ArtifactRef"
    },
    "catalog_ref": {
      "description": "Принятый каталог требований; null допустим при начальной проверке.",
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_refs": {
      "type": "array",
      "description": "Документы и файлы, которые нужно проверить.",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      }
    },
    "diff_ref": {
      "description": "Изменения относительно базы; null для этапа без diff.",
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "memory_index_ref": {
      "description": "Индекс полного архива; записи читаются по необходимости.",
      "$ref": "#/$defs/ArtifactRef"
    },
    "focus": {
      "type": "array",
      "description": "Риски и вопросы, на которых сосредоточить обзор.",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Для ArtifactRef: путь относительно корня проекта; для Issue: путь поля в JSON."
        },
        "sha256": {
          "description": "Хеш точного содержимого файла; проверяется при чтении.",
          "$ref": "#/$defs/Hash"
        },
        "media_type": {
          "type": "string",
          "description": "MIME-тип файла."
        }
      }
    },
    "Hash": {
      "type": "string"
    },
    "ReviewRequest": {
      "type": "object",
      "description": "Контроллер → ревьюер. Независимое чтение кода, условий и тестов.",
      "required": [
        "contract",
        "version",
        "scope",
        "subject",
        "context_ref",
        "catalog_ref",
        "subject_refs",
        "diff_ref",
        "memory_index_ref",
        "focus"
      ],
      "additionalProperties": false,
      "properties": {
        "contract": {
          "description": "Имя типа сообщения; выбирает схему.",
          "enum": [
            "ReviewRequest"
          ],
          "type": "string"
        },
        "version": {
          "description": "Версия формата; здесь только v1.",
          "enum": [
            "v1"
          ],
          "type": "string"
        },
        "scope": {
          "description": "Проект, версия ТЗ, версия кода и раунд.",
          "$ref": "#/$defs/Scope"
        },
        "subject": {
          "type": "string",
          "description": "Что рассматривает ревьюер: разбиение, план, код или тесты.",
          "enum": [
            "decomposition",
            "plan",
            "code",
            "scenarios",
            "catalog"
          ]
        },
        "context_ref": {
          "description": "Вход рассматриваемого этапа: DecompositionInput, PlannerInput или CoderAssignment.",
          "$ref": "#/$defs/ArtifactRef"
        },
        "catalog_ref": {
          "description": "Принятый каталог требований; null допустим при начальной проверке.",
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject_refs": {
          "type": "array",
          "description": "Документы и файлы, которые нужно проверить.",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "diff_ref": {
          "description": "Изменения относительно базы; null для этапа без diff.",
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "memory_index_ref": {
          "description": "Индекс полного архива; записи читаются по необходимости.",
          "$ref": "#/$defs/ArtifactRef"
        },
        "focus": {
          "type": "array",
          "description": "Риски и вопросы, на которых сосредоточить обзор.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Scope": {
      "type": "object",
      "required": [
        "project_id",
        "spec_revision",
        "source_revision",
        "round"
      ],
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "description": "Устойчивый ID проекта."
        },
        "spec_revision": {
          "description": "SHA-256 канонического манифеста ТЗ и явных уточнений.",
          "$ref": "#/$defs/Hash"
        },
        "source_revision": {
          "description": "SHA-256 канонического манифеста исходников снимка.",
          "$ref": "#/$defs/Hash"
        },
        "round": {
          "type": "integer",
          "description": "Номер попытки; не процент готовности."
        }
      }
    }
  }
}
