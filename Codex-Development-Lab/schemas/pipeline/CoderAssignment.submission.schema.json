{
  "type": "object",
  "description": "Контроллер → кодер. Принятый план и границы рабочей области.",
  "required": [
    "contract",
    "version",
    "scope",
    "plan_ref",
    "catalog_ref",
    "graph_ref",
    "memory_index_ref",
    "writable_roots",
    "instructions",
    "condition_progress_ref"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "description": "Имя типа сообщения; выбирает схему.",
      "enum": [
        "CoderAssignment"
      ],
      "type": "string"
    },
    "version": {
      "description": "Версия формата; здесь только v1.",
      "enum": [
        "v1"
      ],
      "type": "string"
    },
    "scope": {
      "description": "Проект, версия ТЗ, версия кода и раунд.",
      "$ref": "#/$defs/Scope"
    },
    "plan_ref": {
      "description": "Принятый план раунда.",
      "$ref": "#/$defs/ArtifactRef"
    },
    "catalog_ref": {
      "description": "Принятый каталог требований; null допустим при начальной проверке.",
      "$ref": "#/$defs/ArtifactRef"
    },
    "graph_ref": {
      "description": "Принятый граф задач; null допустим при начальной проверке.",
      "$ref": "#/$defs/ArtifactRef"
    },
    "memory_index_ref": {
      "description": "Индекс полного архива; записи читаются по необходимости.",
      "$ref": "#/$defs/ArtifactRef"
    },
    "writable_roots": {
      "type": "array",
      "description": "Разрешённые области записи; физически задаются исполнителем.",
      "items": {
        "type": "string"
      }
    },
    "instructions": {
      "type": "array",
      "description": "Явные инструкции этапа.",
      "items": {
        "type": "string"
      }
    },
    "condition_progress_ref": {
      "$ref": "#/$defs/ArtifactRef",
      "description": "Controller-owned per-condition attempt index; full histories and scheduling advice are linked, not repeated inline. Optional for older checkpoints."
    }
  },
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Для ArtifactRef: путь относительно корня проекта; для Issue: путь поля в JSON."
        },
        "sha256": {
          "description": "Хеш точного содержимого файла; проверяется при чтении.",
          "$ref": "#/$defs/Hash"
        },
        "media_type": {
          "type": "string",
          "description": "MIME-тип файла."
        }
      }
    },
    "CoderAssignment": {
      "type": "object",
      "description": "Контроллер → кодер. Принятый план и границы рабочей области.",
      "required": [
        "contract",
        "version",
        "scope",
        "plan_ref",
        "catalog_ref",
        "graph_ref",
        "memory_index_ref",
        "writable_roots",
        "instructions",
        "condition_progress_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "contract": {
          "description": "Имя типа сообщения; выбирает схему.",
          "enum": [
            "CoderAssignment"
          ],
          "type": "string"
        },
        "version": {
          "description": "Версия формата; здесь только v1.",
          "enum": [
            "v1"
          ],
          "type": "string"
        },
        "scope": {
          "description": "Проект, версия ТЗ, версия кода и раунд.",
          "$ref": "#/$defs/Scope"
        },
        "plan_ref": {
          "description": "Принятый план раунда.",
          "$ref": "#/$defs/ArtifactRef"
        },
        "catalog_ref": {
          "description": "Принятый каталог требований; null допустим при начальной проверке.",
          "$ref": "#/$defs/ArtifactRef"
        },
        "graph_ref": {
          "description": "Принятый граф задач; null допустим при начальной проверке.",
          "$ref": "#/$defs/ArtifactRef"
        },
        "memory_index_ref": {
          "description": "Индекс полного архива; записи читаются по необходимости.",
          "$ref": "#/$defs/ArtifactRef"
        },
        "writable_roots": {
          "type": "array",
          "description": "Разрешённые области записи; физически задаются исполнителем.",
          "items": {
            "type": "string"
          }
        },
        "instructions": {
          "type": "array",
          "description": "Явные инструкции этапа.",
          "items": {
            "type": "string"
          }
        },
        "condition_progress_ref": {
          "$ref": "#/$defs/ArtifactRef",
          "description": "Controller-owned per-condition attempt index; full histories and scheduling advice are linked, not repeated inline. Optional for older checkpoints."
        }
      }
    },
    "Hash": {
      "type": "string"
    },
    "Scope": {
      "type": "object",
      "required": [
        "project_id",
        "spec_revision",
        "source_revision",
        "round"
      ],
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "description": "Устойчивый ID проекта."
        },
        "spec_revision": {
          "description": "SHA-256 канонического манифеста ТЗ и явных уточнений.",
          "$ref": "#/$defs/Hash"
        },
        "source_revision": {
          "description": "SHA-256 канонического манифеста исходников снимка.",
          "$ref": "#/$defs/Hash"
        },
        "round": {
          "type": "integer",
          "description": "Номер попытки; не процент готовности."
        }
      }
    }
  }
}
