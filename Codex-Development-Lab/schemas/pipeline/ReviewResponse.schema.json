{
  "type": "object",
  "properties": {
    "contract": {
      "const": "ReviewResponse",
      "description": "Имя типа сообщения; выбирает схему."
    },
    "version": {
      "const": "v1",
      "description": "Версия формата; здесь только v1."
    },
    "scope": {
      "$ref": "#/$defs/Scope",
      "description": "Проект, версия ТЗ, версия кода и раунд."
    },
    "review_ref": {
      "$ref": "#/$defs/ArtifactRef",
      "description": "Ревью, на которое отвечает кодер."
    },
    "responses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FindingResponse"
      },
      "description": "Ответ на каждое замечание."
    }
  },
  "required": [
    "contract",
    "version",
    "scope",
    "review_ref",
    "responses"
  ],
  "additionalProperties": false,
  "description": "Кодер → ревьюер. Ответ на каждое замечание с подтверждением.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewResponse — runtime v1",
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Для ArtifactRef: путь относительно корня проекта; для Issue: путь поля в JSON.",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:\\x00])[^/]+(?:/[^/]+)*$"
        },
        "sha256": {
          "$ref": "#/$defs/Hash",
          "description": "Хеш точного содержимого файла; проверяется при чтении."
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "description": "MIME-тип файла."
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "additionalProperties": false
    },
    "FindingResponse": {
      "type": "object",
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1,
          "description": "ID замечания ревьюера."
        },
        "disposition": {
          "type": "string",
          "enum": [
            "fixed",
            "rejected_with_reason",
            "unverified"
          ],
          "description": "Вердикт ревью или ответ кодера; не статус теста."
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "description": "Обоснование исправления, отклонения или неизвестности."
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "description": "Цитаты из файлов; доверие к выводу проверяется отдельно."
        }
      },
      "required": [
        "finding_id",
        "disposition",
        "explanation",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ReviewResponse": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "ReviewResponse",
          "description": "Имя типа сообщения; выбирает схему."
        },
        "version": {
          "const": "v1",
          "description": "Версия формата; здесь только v1."
        },
        "scope": {
          "$ref": "#/$defs/Scope",
          "description": "Проект, версия ТЗ, версия кода и раунд."
        },
        "review_ref": {
          "$ref": "#/$defs/ArtifactRef",
          "description": "Ревью, на которое отвечает кодер."
        },
        "responses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FindingResponse"
          },
          "description": "Ответ на каждое замечание."
        }
      },
      "required": [
        "contract",
        "version",
        "scope",
        "review_ref",
        "responses"
      ],
      "additionalProperties": false,
      "description": "Кодер → ревьюер. Ответ на каждое замечание с подтверждением."
    },
    "Scope": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "description": "Устойчивый ID проекта."
        },
        "spec_revision": {
          "$ref": "#/$defs/Hash",
          "description": "SHA-256 канонического манифеста ТЗ и явных уточнений."
        },
        "source_revision": {
          "$ref": "#/$defs/Hash",
          "description": "SHA-256 канонического манифеста исходников снимка."
        },
        "round": {
          "type": "integer",
          "minimum": 0,
          "description": "Номер попытки; не процент готовности."
        }
      },
      "required": [
        "project_id",
        "spec_revision",
        "source_revision",
        "round"
      ],
      "additionalProperties": false
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef",
          "description": "Файл, из которого взята цитата."
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "description": "Первая строка фрагмента, с 1."
        },
        "end_line": {
          "type": "integer",
          "minimum": 1,
          "description": "Последняя строка фрагмента включительно."
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "description": "Точная цитата из указанной версии файла."
        }
      },
      "required": [
        "artifact",
        "start_line",
        "end_line",
        "excerpt"
      ],
      "additionalProperties": false
    }
  }
}
