FROM eclipse-temurin:21-jdk-noble
ARG CODEX_VERSION=0.162.1
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg git unzip xz-utils python3 python3-pip python3-pytest python3-venv maven \
    xvfb xauth ffmpeg libgl1 libgl1-mesa-dri libasound2t64 \
    libx11-6 libxrandr2 libxi6 libxcursor1 libxinerama1 libxxf86vm1 \
    libfreetype6 libgtk-3-0 libnss3 libdbus-1-3 fontconfig \
    && rm -rf /var/lib/apt/lists/*
# Node.js 22 for Codex CLI: use upstream Node binary distribution; no execution of curl | bash.
ARG NODE_VERSION=22.16.0
RUN set -eu; case "$(uname -m)" in x86_64) arch=x64;; aarch64) arch=arm64;; *) exit 1;; esac; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${arch}.tar.xz" -o /tmp/node.tar.xz; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" -o /tmp/shas; \
    grep " node-v${NODE_VERSION}-linux-${arch}.tar.xz$" /tmp/shas | sed "s|node-v${NODE_VERSION}-linux-${arch}.tar.xz|/tmp/node.tar.xz|" | sha256sum -c -; \
    mkdir -p /opt/node;tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1;rm /tmp/node.tar.xz /tmp/shas
ENV PATH="/opt/node/bin:/opt/gradle/bin:${PATH}"
RUN npm install -g "@openai/codex@${CODEX_VERSION}" && codex --version \
    && codex exec --skip-git-repo-check --sandbox danger-full-access \
       -c 'approval_policy="never"' --json --help >/dev/null
ARG GRADLE_VERSION=9.2.1
RUN set -eu; curl -fsSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o /tmp/gradle.zip; \
    curl -fsSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip.sha256" -o /tmp/sha; \
    echo "$(cat /tmp/sha)  /tmp/gradle.zip" | sha256sum -c -; \
    unzip -q /tmp/gradle.zip -d /opt;ln -s "/opt/gradle-${GRADLE_VERSION}" /opt/gradle;rm /tmp/gradle.zip /tmp/sha
RUN set -eu; \
    if ! getent passwd 1000 >/dev/null; then useradd -m -u 1000 -s /bin/bash lab; fi; \
    mkdir -p /projects /artifacts /data /backup-requests /home/lab/.codex /home/lab/.gradle; \
    chown -R 1000:1000 /projects /artifacts /data /backup-requests /home/lab
COPY requirements.agent.txt /tmp/requirements.agent.txt
RUN python3 -m pip install --no-cache-dir --break-system-packages -r /tmp/requirements.agent.txt
COPY common /opt/lab/common
COPY schemas /opt/lab/schemas
COPY worker /opt/lab/worker
COPY agent /opt/lab/agent
COPY skills /opt/lab/skills
COPY AGENTS.md /opt/lab/AGENTS.md
ENV PYTHONPATH=/opt/lab HOME=/home/lab CODEX_HOME=/home/lab/.codex GRADLE_USER_HOME=/home/lab/.gradle
USER 1000:1000
WORKDIR /projects
CMD ["python3","/opt/lab/worker/engine.py"]
