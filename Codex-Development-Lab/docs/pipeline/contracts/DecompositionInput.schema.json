{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecompositionInput — proposal-v1",
  "$ref": "#/$defs/DecompositionInput",
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "MIME-тип файла."
        },
        "sha256": {
          "$ref": "#/$defs/Hash",
          "description": "Хеш точного содержимого файла; проверяется при чтении."
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "description": "MIME-тип файла."
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "additionalProperties": false
    },
    "DecompositionInput": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "DecompositionInput",
          "description": "Имя типа сообщения; выбирает схему."
        },
        "version": {
          "const": "proposal-v1",
          "description": "Версия формата; здесь только proposal-v1."
        },
        "scope": {
          "$ref": "#/$defs/Scope",
          "description": "Проект, версия ТЗ, версия кода и раунд."
        },
        "spec_file": {
          "$ref": "#/$defs/ArtifactRef",
          "description": "Сохранённый исходный Markdown."
        },
        "clarifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "description": "Явные уточнения пользователя; отдельные файлы."
        },
        "previous_catalog_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "description": "Предыдущие каталоги при изменении ТЗ."
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Явные инструкции этапа."
        }
      },
      "required": [
        "contract",
        "version",
        "scope",
        "spec_file",
        "clarifications",
        "previous_catalog_refs",
        "instructions"
      ],
      "additionalProperties": false,
      "description": "Контроллер → LLM-планировщик. Исходное ТЗ доступно целиком по ссылке."
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Scope": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "description": "Устойчивый ID проекта."
        },
        "spec_revision": {
          "$ref": "#/$defs/Hash",
          "description": "SHA-256 канонического манифеста ТЗ и явных уточнений."
        },
        "source_revision": {
          "$ref": "#/$defs/Hash",
          "description": "SHA-256 канонического манифеста исходников снимка."
        },
        "round": {
          "type": "integer",
          "minimum": 0,
          "description": "Номер попытки; не процент готовности."
        }
      },
      "required": [
        "project_id",
        "spec_revision",
        "source_revision",
        "round"
      ],
      "additionalProperties": false
    }
  }
}
