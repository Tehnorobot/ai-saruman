# Codex Development Lab: generated state, queues and historical skill copies
# Existing component rules also exclude projects, artifacts, databases and backups.
/Codex-Development-Lab/backup-requests/*
!/Codex-Development-Lab/backup-requests/.gitkeep
/Codex-Development-Lab/runner-output/
/Codex-Development-Lab/minimax-probe-results/
/Codex-Development-Lab/skills_outdated/

# Audit scripts and Markdown documentation remain versioned.
# Subdirectories hold isolated runs, copied workspaces, screenshots and reports.
